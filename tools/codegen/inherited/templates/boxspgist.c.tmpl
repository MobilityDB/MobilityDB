/*****************************************************************************
 * SP-GiST leaf consistency function
 *****************************************************************************/

PGDLLEXPORT Datum {PREFIX}_spgist_leaf_consistent(PG_FUNCTION_ARGS);
PG_FUNCTION_INFO_V1({PREFIX}_spgist_leaf_consistent);
/**
 * @brief SP-GiST leaf consistency function for {NOUN}
 */
Datum
{PREFIX}_spgist_leaf_consistent(PG_FUNCTION_ARGS)
{
  spgLeafConsistentIn *in = (spgLeafConsistentIn *) PG_GETARG_POINTER(0);
  spgLeafConsistentOut *out = (spgLeafConsistentOut *) PG_GETARG_POINTER(1);
  {CTYPE} *key = {DATUMGET}(in->leafDatum), box;
  bool result = true;
  int i;

{RECHECKINIT}
  /* leafDatum is what it is... */
  out->leafValue = in->leafDatum;

  /* Perform the required comparison(s) */
  for (i = 0; i < in->nkeys; i++)
  {
    StrategyNumber strategy = in->scankeys[i].sk_strategy;
    /* Update the recheck flag according to the strategy */
    out->recheck |= {BOX}_index_recheck(strategy);

    const ScanKeyData *scankey = &in->scankeys[i];
    Datum value = scankey->sk_argument;
    MeosType type = oid_meostype(scankey->sk_subtype);
{LEAFEXTRA}    /* The box is zeroed before each call, so that a query for which
     * #{GETBOX} writes nothing, such as an empty geometry, carries neither the
     * stack nor the previous key */
    memset(&box, 0, sizeof({CTYPE}));
    {GETBOX}(value, type, &box);
    /* Where the operator raises its error on the box, the recheck applies it
     * to the row */
    if (! index_strategy_is_valid({MEOSTYPE}, strategy, key, &box))
    {
      out->recheck = true;
      continue;
    }
    result = {BOX}_index_leaf_consistent(key, &box, strategy);

    /* If any check is failed, we have found our answer */
    if (! result)
      break;
  }

  if (result && in->norderbys > 0)
  {
    /* Recheck is necessary when computing distance with bounding boxes */
    out->recheckDistances = true;
    double *distances = palloc(sizeof(double) * in->norderbys);
    out->distances = distances;
    for (i = 0; i < in->norderbys; i++)
    {
      /* Convert the order by argument to a box and perform the test */
      const ScanKeyData *scankey = &in->orderbys[i];
      Datum value = scankey->sk_argument;
      MeosType type = oid_meostype(scankey->sk_subtype);
      memset(&box, 0, sizeof({CTYPE}));
      {GETBOX}(value, type, &box);
      /* Where the distance raises its error on the key, the entry is
       * visited before every other one, and the recheck applies the operator
       * to the row, which raises it or, for an empty geometry, answers no
       * distance */
      if (! index_distance_is_valid({MEOSTYPE}, key, &box))
      {
        distances[i] = -get_float8_infinity();
        continue;
      }
{LEAFDISTANCE}
    }
  }

  PG_RETURN_BOOL(result);
}

