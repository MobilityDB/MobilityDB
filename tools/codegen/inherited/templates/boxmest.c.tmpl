
PG_FUNCTION_INFO_V1({CSTEM}_mest_equisplit);
/**
 * @brief Multi-entry extract method keyed by a number of boxes
 * @details The keys of a {NOUN} are a number of
 * {NOUNBOXES} of its consecutive instants or segments, the number being
 * the option of the class (#mest_count) and the split that of
 * #{PFX}_split_n_{BOXES}
 */
Datum
{CSTEM}_mest_equisplit(PG_FUNCTION_ARGS)
{
  Temporal *temp = PG_GETARG_TEMPORAL_P(0);
  int32 *nkeys = (int32 *) PG_GETARG_POINTER(1);
  {CTYPE} *boxes = {PFX}_split_n_{BOXES}_intl(temp, mest_count(fcinfo), nkeys);
  PG_RETURN_POINTER(mest_keys(boxes, sizeof({CTYPE}), *nkeys));
}

