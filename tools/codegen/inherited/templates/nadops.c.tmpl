PGDLLEXPORT Datum NAD_{TNUM}_{SPAN}(PG_FUNCTION_ARGS);
PG_FUNCTION_INFO_V1(NAD_{TNUM}_{SPAN});
/**
 * @ingroup {NADGROUP}
 * @brief Return the nearest approach distance between {ATNUMDESC} and {ASPANDESC}
 * @sqlfn nearestApproachDistance()
 * @sqlop @p |=|
 */
Datum
NAD_{TNUM}_{SPAN}(PG_FUNCTION_ARGS)
{
  Temporal *temp = PG_GETARG_TEMPORAL_P(0);
  Span *s = PG_GETARG_SPAN_P(1);
  /* The SQL signatures pair each temporal number with the span of its number */
  assert(temptype_basetype(temp->temptype) == s->basetype);
  Datum result = nad_{TSIDE}_{VSBOX}(temp, s);
  PG_FREE_IF_COPY(temp, 0);
  return NAD_{VSBOX}_result(fcinfo, result, s->basetype);
}

