PGDLLEXPORT Datum NAD_{BOX}_{BOX}(PG_FUNCTION_ARGS);
PG_FUNCTION_INFO_V1(NAD_{BOX}_{BOX});
/**
 * @ingroup {NADGROUP}
 * @brief Return the nearest approach distance between two {BOXDESCPL}
 * @sqlfn nearestApproachDistance()
 * @sqlop @p |=|
 */
Datum
NAD_{BOX}_{BOX}(PG_FUNCTION_ARGS)
{
  {BOXC} *box1 = {GETARG}(0);
  {BOXC} *box2 = {GETARG}(1);
  /* Ensure the validity of the arguments: the kernel states these as
   * assertions, and this wrapper is an external entry that reaches it with no
   * MEOS function in between */
  if (! ensure_valid_{BOX}_{BOX}(box1, box2) ||
      ! ensure_has_X({BOXTYPE}, box1->flags) ||
      ! ensure_has_X({BOXTYPE}, box2->flags))
    PG_RETURN_NULL();
  MeosType basetype = box1->span.basetype;
  Datum result = nad_{BOX}_{BOX}(box1, box2);
  if (datum_eq(result, distance_sentinel(basetype), basetype))
    PG_RETURN_NULL();
  PG_RETURN_FLOAT8(distance_double(result, basetype));
}

