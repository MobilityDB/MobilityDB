/*
 * Spatial relationships for temporal cell indices.
 *
 * Each {TEMP} value carries one cell per instant. The spatial
 * relations defined here operate on the cell's BOUNDARY POLYGON (not
 * the cell's centre point), matching the prefilter semantics in
 * `geoToH3IndexSet` / `everIntersectsH3IndexSet_Th3Index` and the user
 * intuition that "the cell occupies its tessellation footprint".
 *
 * Implementation: each function delegates to the tgeometry spatial-rel
 * via `{BOUNDARY}({TEMP}) :: tgeometry`. The cell boundary
 * is generated by the libh3 `cellToBoundary` routine and serialised as
 * a tgeography polygon-per-instant; the cast to tgeometry strips the
 * geodetic flag while preserving the coordinates (SRID 4326). Inputs
 * not in SRID 4326 should be transformed beforehand.
 *
 * For SRID-4326 inputs the SQL composition is exact under the cell-
 * boundary semantics that underpin H3's hexagonal tessellation; no
 * cell-centre approximation. Spark / DuckDB consumers that previously
 * had to construct these predicates manually via the prefilter pattern
 * (`geoToH3IndexSet(geom, res) && trip_h3`) can now write the natural
 * `WHERE eIntersects(region.geom, trips.trip_h3)` form.
 */

/*****************************************************************************
 * Ever/always contains
 *****************************************************************************/

CREATE FUNCTION eContains(geometry, {TEMP})
  RETURNS boolean
  LANGUAGE SQL IMMUTABLE STRICT PARALLEL SAFE
  AS $$ SELECT @extschema@.eContains($1, @extschema@.{BOUNDARY}($2)::@extschema@.tgeometry) $$;
CREATE FUNCTION aContains(geometry, {TEMP})
  RETURNS boolean
  LANGUAGE SQL IMMUTABLE STRICT PARALLEL SAFE
  AS $$ SELECT @extschema@.aContains($1, @extschema@.{BOUNDARY}($2)::@extschema@.tgeometry) $$;

CREATE FUNCTION eContains({TEMP}, geometry)
  RETURNS boolean
  LANGUAGE SQL IMMUTABLE STRICT PARALLEL SAFE
  AS $$ SELECT @extschema@.eContains(@extschema@.{BOUNDARY}($1)::@extschema@.tgeometry, $2) $$;
CREATE FUNCTION aContains({TEMP}, geometry)
  RETURNS boolean
  LANGUAGE SQL IMMUTABLE STRICT PARALLEL SAFE
  AS $$ SELECT @extschema@.aContains(@extschema@.{BOUNDARY}($1)::@extschema@.tgeometry, $2) $$;

CREATE FUNCTION eContains({TEMP}, {TEMP})
  RETURNS boolean
  LANGUAGE SQL IMMUTABLE STRICT PARALLEL SAFE
  AS $$ SELECT @extschema@.eContains(@extschema@.{BOUNDARY}($1)::@extschema@.tgeometry,
                          @extschema@.{BOUNDARY}($2)::@extschema@.tgeometry) $$;
CREATE FUNCTION aContains({TEMP}, {TEMP})
  RETURNS boolean
  LANGUAGE SQL IMMUTABLE STRICT PARALLEL SAFE
  AS $$ SELECT @extschema@.aContains(@extschema@.{BOUNDARY}($1)::@extschema@.tgeometry,
                          @extschema@.{BOUNDARY}($2)::@extschema@.tgeometry) $$;

