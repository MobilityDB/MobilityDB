/**
 * @file
 * @brief GiST operator class for `{TEMP}`
 * @details The bounding box of a `{TEMP}` value is the spatiotemporal box of
 * its cell, so the operator class stores an `stbox` and indexes the
 * topological, position and time operators through that box, as the operator
 * classes of `tgeompoint` and `tcbuffer` do. The consistent and compress
 * support functions are `Stbox_gist_consistent` and `tspatial_gist_compress`,
 * and the union, penalty, picksplit and same functions are those of `stbox`.
 */

/******************************************************************************
 * Support functions ({TEMP}-typed wrappers)
 ******************************************************************************/

CREATE FUNCTION {TEMP}_gist_consistent(internal, {TEMP}, smallint, oid, internal)
  RETURNS boolean
  AS 'MODULE_PATHNAME', 'Stbox_gist_consistent'
  LANGUAGE C IMMUTABLE STRICT PARALLEL SAFE;

/******************************************************************************
 * Operator class
 ******************************************************************************/

{TEMPOPCLASS_RTREE}
-- @IF setindex
/******************************************************************************
 * Sets of the base values, keyed by the box they store, the set operators
 * rechecked on the set
 ******************************************************************************/

CREATE FUNCTION {SET}_gist_consistent(internal, {SET}, smallint, oid, internal)
  RETURNS boolean
  AS 'MODULE_PATHNAME', 'Stbox_gist_consistent'
  LANGUAGE C IMMUTABLE STRICT PARALLEL SAFE;
-- @IF setmetric
CREATE FUNCTION {SET}_gist_distance(internal, {SET}, smallint, oid, internal)
  RETURNS float
  AS 'MODULE_PATHNAME', 'Tspatial_gist_distance'
  LANGUAGE C IMMUTABLE STRICT PARALLEL SAFE;
-- @ENDIF

CREATE OPERATOR CLASS {SET}_rtree_ops
  DEFAULT FOR TYPE {SET} USING gist AS
  STORAGE stbox,
  -- overlaps
  OPERATOR  3    && ({SET}, {SET}),
  -- same
  OPERATOR  6    = ({SET}, {SET}),
  -- contains
  OPERATOR  7    @> ({SET}, {BASE}),
  OPERATOR  7    @> ({SET}, {SET}),
  -- contained by
  OPERATOR  8    <@ ({SET}, {SET}),
-- @IF setmetric
  -- nearest approach distance
  OPERATOR  25    <-> ({SET}, {BASE}) FOR ORDER BY pg_catalog.float_ops,
  OPERATOR  25    <-> ({SET}, {SET}) FOR ORDER BY pg_catalog.float_ops,
-- @ENDIF
  -- functions
  FUNCTION  1 {SET}_gist_consistent(internal, {SET}, smallint, oid, internal),
  FUNCTION  2 stbox_gist_union(internal, internal),
  FUNCTION  3 spatialset_gist_compress(internal),
  FUNCTION  5 stbox_gist_penalty(internal, internal, internal),
  FUNCTION  6 stbox_gist_picksplit(internal, internal),
  FUNCTION  7 stbox_gist_same(stbox, stbox, internal),
-- @IF setmetric
  FUNCTION  8 {SET}_gist_distance(internal, {SET}, smallint, oid, internal),
-- @ENDIF
  FUNCTION 11 stbox_gist_sortsupport(internal);

-- @ENDIF
{BOXMEMBERS}/******************************************************************************/
