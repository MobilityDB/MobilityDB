/**
 * @brief Return an array of N {NOUNBOXES} from the instants
 * of a {NOUN} sequence with discrete interpolation
 * @param[in] seq Temporal sequence
 * @param[in] {NCOUNT} Number of boxes
 * @param[out] count Number of elements in the output array
 */
static {CTYPE} *
{SEQ}_disc_split_n_{BOXES}(const TSequence *seq, int {NCOUNT}, int *count{CTXDECL})
{
  assert(seq); assert(count); assert({TYPEP}(seq->temptype));
  assert(MEOS_FLAGS_GET_INTERP(seq->flags) == DISCRETE);
  assert({NCOUNT} > 0);

  /* One bounding box per instant */
  if (seq->count <= {NCOUNT})
  {
    *count = seq->count;
    return {SEQ}_disc_{BOXES}(seq{CTXPASS});
  }

  /* One bounding box per several consecutive instants */
  {CTYPE} *result = palloc(sizeof({CTYPE}) * {NCOUNT});
  /* Minimum number of input instants merged together in an output box */
  int size = seq->count / {NCOUNT};
  /* Number of output boxes that result from merging (size + 1) instants */
  int remainder = seq->count % {NCOUNT};
  int i = 0; /* Loop variable for input instants */
  for (int k = 0; k < {NCOUNT}; k++)
  {
    int j = i + size;
    if (k < remainder)
      j++;
    {INSTSET}((const Temporal *) seq, TSEQUENCE_INST_N(seq, i), &result[k]);
    for (int l = i + 1; l < j; l++)
    {
      {CTYPE} box;
      {INSTSET}((const Temporal *) seq, TSEQUENCE_INST_N(seq, l), &box);
      {EXPAND}(&box, &result[k]);
    }
    i = j;
  }
  assert(i == seq->count);
  *count = {NCOUNT};
  return result;
}

/**
 * @brief Return an array of N {NOUNBOXES} from the segments of a 
 * {NOUN} sequence with continuous interpolation (iterator function)
 * @param[in] seq {NOUNCAP}
 * @param[in] {NCOUNT} Number of boxes
 * @param[out] result Array of boxes
 */
static int
{SEQ}_cont_split_n_{BOXES}_iter(const TSequence *seq, int {NCOUNT},
  {CTYPE} *result{CTXDECL})
{
  assert(seq); assert(result); assert({TYPEP}(seq->temptype));
  assert(MEOS_FLAGS_GET_INTERP(seq->flags) != DISCRETE);
  assert({NCOUNT} > 0);

  /* Instantaneous sequence */
  if (seq->count == 1)
  {
    {SLICE}(seq, 0, 0, &result[0]);
    return 1;
  }

  /* One bounding box per segment */
  int nsegs = seq->count - 1;
  if (nsegs <= {NCOUNT})
    return {SEQ}_cont_{BOXES}_iter(seq, result{CTXPASS});

  /* One bounding box per several consecutive segments */
  /* Minimum number of input segments merged together in an output box */
  int size = nsegs / {NCOUNT};
  /* Number of output boxes that result from merging (size + 1) segments */
  int remainder = nsegs % {NCOUNT};
  int i = 0; /* Loop variable for input segments */
  for (int k = 0; k < {NCOUNT}; k++)
  {
    int j = i + size;
    if (k < remainder)
      j++;
    {SLICE}(seq, i, j, &result[k]);
    i = j;
  }
  assert(i == nsegs);
  return {NCOUNT};
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of N {NOUNBOXES} from the instants or
 * segments of a {NOUN} sequence
 * @details The choice between instants or segments depends, respectively, on
 * whether the interpolation is discrete or continuous.
 * @param[in] seq Temporal sequence
 * @param[in] {NCOUNT} Number of boxes
 * @param[out] count Number of elements in the output array
 * @return If `seq->count <= {NCOUNT}`, the result contains one box
 * per instant or segment. Otherwise, consecutive instants or segments are
 * combined into a single box in the result to reach the given number of
 * boxes.
 */
{CTYPE} *
{SEQ}_split_n_{BOXES}(const TSequence *seq, int {NCOUNT}, int *count{CTXDECL})
{
  assert(seq); assert(count); assert({TYPEP}(seq->temptype));
  assert({NCOUNT} > 0);

  /* Discrete case */
  if (MEOS_FLAGS_GET_INTERP(seq->flags) == DISCRETE)
    return {SEQ}_disc_split_n_{BOXES}(seq, {NCOUNT}, count{CTXPASS});

  /* Continuous case */
  int nboxes = (seq->count <= {NCOUNT}) ?
    (seq->count == 1 ? 1 : seq->count - 1) : {NCOUNT};
  {CTYPE} *result = palloc(sizeof({CTYPE}) * nboxes);
  *count = {SEQ}_cont_split_n_{BOXES}_iter(seq, {NCOUNT}, result{CTXPASS});
  return result;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of N {NOUNBOXES} from the segments of a
 * {NOUN} sequence set
 * @param[in] ss Temporal sequence set
 * @param[in] {NCOUNT} Number of boxes
 * @param[out] count Number of elements in the output array
 * @return If `ss->totalcount <= {NCOUNT}`, the result contains one box per
 * segment. Otherwise, consecutive input segments are combined into a single box in
 * the result to reach the given number of boxes.
 */
{CTYPE} *
{SEQSET}_split_n_{BOXES}(const TSequenceSet *ss, int {NCOUNT}, int *count{CTXDECL})
{
  assert(ss); assert(count); assert({TYPEP}(ss->temptype));
  assert({NCOUNT} > 0);

  /* One bounding box per segment */
  if (ss->totalcount <= {NCOUNT})
    return {SEQSET}_{BOXES}(ss, count{CTXPASS});

  /* At most {NCOUNT} boxes, the segments being more */
  {CTYPE} *result = palloc(sizeof({CTYPE}) * {NCOUNT});

  /* Number of bounding boxes per composing sequence determined from the
   * proportion of seq->count and ss->totalcount */
  if (ss->count <= {NCOUNT})
  {
    int nboxes1 = 0;
    for (int i = 0; i < ss->count; i++)
    {
      bool end = false;
      const TSequence *seq = TSEQUENCESET_SEQ_N(ss, i);
      int nboxes_seq = (int) ({NCOUNT} * seq->count * 1.0 / ss->totalcount);
      if (! nboxes_seq)
        nboxes_seq = 1;
      if (nboxes_seq + nboxes1 >= {NCOUNT})
      {
        end = true;
        nboxes_seq = {NCOUNT} - nboxes1;
      }
      nboxes1 += {SEQ}_cont_split_n_{BOXES}_iter(seq, nboxes_seq,
        &result[nboxes1]{CTXPASS});
      if (end)
        break;
    }
    assert(nboxes1 <= {NCOUNT});
    *count = nboxes1;
    return result;
  }

  /* Merge consecutive sequences to reach the maximum number of boxes */
  /* Minimum number of sequences merged together in an output box */
  int size = ss->count / {NCOUNT};
  /* Number of output boxes that result from merging (size + 1) sequences */
  int remainder = ss->count % {NCOUNT};
  int i = 0; /* Loop variable for input sequences */
  for (int k = 0; k < {NCOUNT}; k++)
  {
    int j = i + size;
    if (k < remainder)
      j++;
    {SEQ}_cont_split_n_{BOXES}_iter(TSEQUENCESET_SEQ_N(ss, i), 1,
      &result[k]{CTXPASS});
    for (int l = i + 1; l < j; l++)
    {
      {CTYPE} box;
      {SEQ}_cont_split_n_{BOXES}_iter(TSEQUENCESET_SEQ_N(ss, l), 1, &box{CTXPASS});
      {EXPAND}(&box, &result[k]);
    }
    i = j;
  }
  assert(i == ss->count);
  *count = {NCOUNT};
  return result;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of N {NOUNBOXES} obtained by merging
 * consecutive instants or segments of a {NOUN}, its arguments valid
 * @details The internal twin of #{PFX}_split_n_{BOXES}, which an index calls
 * @param[in] temp {NOUNCAP}
 * @param[in] {NCOUNT} Number of boxes
 * @param[out] count Number of elements in the output array
