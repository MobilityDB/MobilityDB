      *count = 1;
      return {INST}_{BOXES}((TInstant *) temp{CTXPASS});
    case TSEQUENCE:
      return {SEQ}_{BOXES}((TSequence *) temp, count{CTXPASS});
    default: /* TSEQUENCESET */
      return {SEQSET}_{BOXES}((TSequenceSet *) temp, count{CTXPASS});
  }
}

