 */
{CTYPE} *
{PFX}_merge_each_n_{BOXES}(const Temporal *temp, int elem_count, int *count)
{
  /* The out parameter is defined even when a later check fails */
  VALIDATE_NOT_NULL(count, NULL);
  *count = 0;
  /* Ensure the validity of the arguments */
  {VALIDATE}(temp, NULL);
  if (! ensure_positive(elem_count))
    return NULL;
  return {PFX}_merge_each_n_{BOXES}_intl(temp, elem_count, count);
}

/*****************************************************************************
 * merge_query_{BOXES} function
 *****************************************************************************/

/**
 * @ingroup {IGROUP}
 * @brief Return an array of {NOUNBOXES} obtained by merging
 * the boxes of the consecutive instants or segments of a
 * {NOUN} into those a query of the extents of a query box
 * is expected to read least, its arguments valid
 * @details The internal twin of #{PFX}_merge_query_{BOXES}, which an index
 * calls
 * @param[in] temp Temporal value
 * @param[in] query Query box
 * @param[out] count Number of values of the output array
 */
{CTYPE} *
{PFX}_merge_query_{BOXES}_intl(const Temporal *temp, const {CTYPE} *query,
  int *count)
{
  assert(temp); assert(query); assert(count);
  assert({TYPEP}(temp->temptype));
  assert({QVALID}(temp, query));
  {CTYPE} *result = {PFX}_{BOXES}_intl(temp, count);
  if (result)
    *count = bbox_merge_query({MBOXTYPE}, result, *count, query, &{MADJUST},
      &{MQSIZE});
  return result;
}

/**
 * @ingroup {GROUP}
 * @brief Return an array of {NOUNBOXES} obtained by merging
 * the boxes of the consecutive instants or segments of a
 * {NOUN} into those a query of the extents of a query box
 * is expected to read least
 * @details The query twin of #{PFX}_merge_n_{BOXES}, by #bbox_merge_query:
 * the widths of the query box are the extents of the query, its position is
 * not read, and a dimension it lacks restricts no query
 * @param[in] temp Temporal value
 * @param[in] query Query box
 * @param[out] count Number of values of the output array
 * @errval NULL
 * @csqlfn #{CSTEM}_merge_query_{BOXES}()
 */
{CTYPE} *
{PFX}_merge_query_{BOXES}(const Temporal *temp, const {CTYPE} *query,
  int *count)
{
  /* The out parameter is defined even when a later check fails */
  VALIDATE_NOT_NULL(count, NULL);
  *count = 0;
  /* Ensure the validity of the arguments */
  {VALIDATE}(temp, NULL); VALIDATE_NOT_NULL(query, NULL);
  if (! {QVALID}(temp, query))
    return NULL;
  return {PFX}_merge_query_{BOXES}_intl(temp, query, count);
}
