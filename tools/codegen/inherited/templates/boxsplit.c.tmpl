/**
 * @ingroup {IGROUP}
 * @brief Return a singleton array of {NOUNBOXES} from a
 * {NOUN} instant
 * @param[in] inst Temporal instant
 */
{CTYPE} *
{INST}_{BOXES}(const TInstant *inst{CTXDECL})
{
  assert(inst); assert({TYPEP}(inst->temptype));
  /* One bounding box per instant */
  {CTYPE} *result = palloc(sizeof({CTYPE}));
  {INSTSET}((const Temporal *) inst, inst, &result[0]);
  return result;
}

/**
 * @brief Return an array of {NOUNBOXES} from the instants
 * of a {NOUN} sequence with discrete interpolation
 * @param[in] seq Temporal sequence
 */
static {CTYPE} *
{SEQ}_disc_{BOXES}(const TSequence *seq{CTXDECL})
{
  assert(seq); assert({TYPEP}(seq->temptype));
  assert(MEOS_FLAGS_GET_INTERP(seq->flags) == DISCRETE);
  /* One bounding box per instant */
  {CTYPE} *result = palloc(sizeof({CTYPE}) * seq->count);
  for (int i = 0; i < seq->count; i++)
    {INSTSET}((const Temporal *) seq, TSEQUENCE_INST_N(seq, i), &result[i]);
  return result;
}

/**
 * @brief Return an array of {NOUNBOXES} from the segments of a
 * {NOUN} sequence with continuous interpolation (iterator function)
 * @param[in] seq Temporal sequence
 * @param[out] result Array of boxes
 * @return Number of elements in the ouput array
 */
static int
{SEQ}_cont_{BOXES}_iter(const TSequence *seq, {CTYPE} *result{CTXDECL})
{
  assert(seq); assert(result); assert({TYPEP}(seq->temptype));
  assert(MEOS_FLAGS_GET_INTERP(seq->flags) != DISCRETE);

  /* Instantaneous sequence */
  if (seq->count == 1)
  {
    {SLICE}(seq, 0, 0, &result[0]);
    return 1;
  }

  /* One bounding box per segment */
  for (int i = 0; i < seq->count - 1; i++)
    {SLICE}(seq, i, i + 1, &result[i]);
  return seq->count - 1;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of {NOUNBOXES} from the instants or segments
 * of a {NOUN} sequence
 * @details The choice between instants or segments depends, respectively, on
 * whether the interpolation is discrete or continuous.
 * @param[in] seq Temporal sequence
 * @param[out] count Number of elements in the output array
 */
{CTYPE} *
{SEQ}_{BOXES}(const TSequence *seq, int *count{CTXDECL})
{
  assert(seq); assert(count); assert({TYPEP}(seq->temptype));

  /* Discrete case */
  if (MEOS_FLAGS_GET_INTERP(seq->flags) == DISCRETE)
  {
    *count = seq->count;
    return {SEQ}_disc_{BOXES}(seq{CTXPASS});
  }

  /* Continuous case */
  int nboxes = (seq->count == 1) ? 1 : seq->count - 1;
  {CTYPE} *result = palloc(sizeof({CTYPE}) * nboxes);
  *count = {SEQ}_cont_{BOXES}_iter(seq, result{CTXPASS});
  return result;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of {NOUNBOXES} from the segments of a
 * {NOUN} sequence set
 * @param[in] ss Temporal sequence set
 * @param[out] count Number of elements in the output array
 */
{CTYPE} *
{SEQSET}_{BOXES}(const TSequenceSet *ss, int *count{CTXDECL})
{
  assert(ss); assert(count); assert({TYPEP}(ss->temptype));

  /* One bounding box per segment */
  {CTYPE} *result = palloc(sizeof({CTYPE}) * ss->totalcount);
  int nboxes = 0;
  for (int i = 0; i < ss->count; i++)
    nboxes += {SEQ}_cont_{BOXES}_iter(TSEQUENCESET_SEQ_N(ss, i),
      &result[nboxes]{CTXPASS});
  assert(nboxes <= ss->totalcount);
  *count = nboxes;
  return result;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of {NOUNBOXES} from the instants or segments
 * of a {NOUN}, its arguments valid
 * @details The internal twin of #{PFX}_{BOXES}, which an index calls
 * @param[in] temp {NOUNCAP}
 * @param[out] count Number of values of the output array
 */
{CTYPE} *
{PFX}_{BOXES}_intl(const Temporal *temp, int *count)
{
  assert(temp); assert(count); assert({TYPEP}(temp->temptype));
{CTXINIT}  assert(temptype_subtype(temp->subtype));
  switch (temp->subtype)
