/*****************************************************************************
 * split_each_n_{BOXES} function
 *****************************************************************************/

/**
 * @brief Return an array of {NOUNBOXES} obtained by merging
 * consecutive instants of a {NOUN} sequence with discrete interpolation
 * @param[in] seq Temporal sequence
 * @param[in] elem_count Number of input instants merged into an output box
 * @param[out] count Number of elements in the output array
 */
static {CTYPE} *
{SEQ}_disc_split_each_n_{BOXES}(const TSequence *seq, int elem_count,
  int *count{CTXDECL})
{
  assert(seq); assert(count); assert({TYPEP}(seq->temptype));
  assert(MEOS_FLAGS_GET_INTERP(seq->flags) == DISCRETE);
  assert(elem_count > 0);

  int nboxes = ceil((double) seq->count / (double) elem_count);
  {CTYPE} *result = palloc(sizeof({CTYPE}) * nboxes);
  int k = 0;
  for (int i = 0; i < seq->count; ++i)
  {
    if (i % elem_count == 0)
      {INSTSET}((const Temporal *) seq, TSEQUENCE_INST_N(seq, i), &result[k++]);
    else
    {
      {CTYPE} box;
      {INSTSET}((const Temporal *) seq, TSEQUENCE_INST_N(seq, i), &box);
      {EXPAND}(&box, &result[k - 1]);
    }
  }
  assert(k == nboxes);
  *count = k;
  return result;
}

/**
 * @brief Return an array of {NOUNBOXES} obtained by merging
 * consecutive segments of a {NOUN} sequence (iterator function)
 * @details The sequence has continuous interpolation.
 * @param[in] seq Temporal sequence
 * @param[in] elem_count Number of input segments merged into an output box
 * @param[out] result Array of boxes
 * @return Number of elements in the output array
 */
static int
{SEQ}_cont_split_each_n_{BOXES}_iter(const TSequence *seq,
  int elem_count, {CTYPE} *result{CTXDECL})
{
  assert(seq); assert(result); assert({TYPEP}(seq->temptype));
  assert(MEOS_FLAGS_GET_INTERP(seq->flags) != DISCRETE);
  assert(elem_count > 0);

  /* Instantaneous sequence */
  if (seq->count == 1)
  {
    {SEQBOX}(seq, &result[0]);
    return 1;
  }

  /* General case */
  int nboxes = ceil((double) (seq->count - 1) / (double) elem_count);
  for (int k = 0; k < nboxes; k++)
  {
    int first = k * elem_count;
    int last = Min(first + elem_count, seq->count - 1);
    {SLICE}(seq, first, last, &result[k]);
  }
  return nboxes;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of {NOUNBOXES} obtained by merging
 * consecutive instants or segments of a {NOUN} sequence
 * @details The choice between instants or segments depends, respectively, on
 * whether the interpolation is discrete or continuous.
 * @param[in] seq Temporal sequence
 * @param[in] elem_count Number of input segments merged into an output box
 * @param[out] count Number of elements in the output array
 */
{CTYPE} *
{SEQ}_split_each_n_{BOXES}(const TSequence *seq, int elem_count,
  int *count{CTXDECL})
{
  assert(seq); assert(count); assert({TYPEP}(seq->temptype));
  assert(elem_count > 0);

  if (MEOS_FLAGS_GET_INTERP(seq->flags) == DISCRETE)
    return {SEQ}_disc_split_each_n_{BOXES}(seq, elem_count, count{CTXPASS});

  /* Number of instants or segments */
  int nelems = (seq->count == 1) ? 1 : seq->count - 1;
  int nboxes = ceil((double) nelems / (double) elem_count);
  {CTYPE} *result = palloc(sizeof({CTYPE}) * nboxes);
  *count = {SEQ}_cont_split_each_n_{BOXES}_iter(seq, elem_count,
    result{CTXPASS});
  return result;
}

/**
 * @ingroup {IGROUP}
 * @brief Return an array of {NOUNBOXES} obtained by merging
 * consecutive segments of a {NOUN} sequence set 
 * @param[in] ss Temporal sequence set
 * @param[in] elem_count Number of input segments merged into an output box
 * @param[out] count Number of elements in the output array
 */
{CTYPE} *
{SEQSET}_split_each_n_{BOXES}(const TSequenceSet *ss, int elem_count,
  int *count{CTXDECL})
{
  assert(ss); assert(count); assert({TYPEP}(ss->temptype));
  assert(elem_count > 0);

  /* Singleton sequence set */
  if (ss->count == 1)
    return {SEQ}_split_each_n_{BOXES}(TSEQUENCESET_SEQ_N(ss, 0),
      elem_count, count{CTXPASS});

  /* Iterate for every composing sequence */
  int nboxes = 0;
  {CTYPE} *result = palloc(sizeof({CTYPE}) * ss->totalcount);
  for (int i = 0; i < ss->count; ++i)
    nboxes += {SEQ}_cont_split_each_n_{BOXES}_iter(
      TSEQUENCESET_SEQ_N(ss, i), elem_count, &result[nboxes]{CTXPASS});
  *count = nboxes;
  return result;
}

