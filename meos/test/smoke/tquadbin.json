  },
  "name_arg_map": {
    "^quadbin_cell_sibling$": {"char *": "\"right\""},
    "^quadbinset_in$": {"char *": "\"{48427fffffffffff}\""},
    "^tquadbin_in$": {"char *": "\"[48427fffffffffff@2001-01-01, 48427fffffffffff@2001-01-03]\""},
    "^tquadbininst_in$": {"char *": "\"48427fffffffffff@2001-01-01\""},
    "^tquadbinseq_in$": {"char *": "\"[48427fffffffffff@2001-01-01, 48427fffffffffff@2001-01-03]\""},
    "^tquadbinseqset_in$": {"char *": "\"{[48427fffffffffff@2001-01-01, 48427fffffffffff@2001-01-03]}\""},
    "^tbigint_to_tquadbin$": {"Temporal *": "tbigint1"},
    "^tgeompoint_": {"Temporal *": "tgeompoint1"}
  },
  "override_args": {
    "quadbin_cell_to_children": {"1": "5"},
    "quadbin_cell_to_children_set": {"1": "5"},
    "tquadbin_cell_to_children": {"1": "5"},
    "tquadbinseq_make": {"0": "qarr_same1", "2": "2"},
    "quadbinset_make": {"0": "qarr1", "1": "2"}
  },
  "manual": ["tquadbin_unnest"],
  "common_inputs": [
    "  TimestampTz tstz1 = timestamptz_in(\"2001-01-01\", -1);",
    "  Span *tstzspan1 = tstzspan_in(\"[2001-01-01, 2001-01-03]\");",
    "  TimestampTz tstzarr1[] = { timestamptz_in(\"2001-01-01\", -1), timestamptz_in(\"2001-01-03\", -1) };",
    "  /* A cell of resolution 4 and the sibling to its right, which MEOS derives",
    "   * from the cell, so the functions of two cells read neighbours it accepts. */",
    "  Quadbin qcell1 = quadbin_in(\"48427fffffffffff\");",
    "  Quadbin qnbr1 = quadbin_cell_sibling(qcell1, \"right\");",
    "  Quadbin qarr1[] = { qcell1, qnbr1 };",
    "  Quadbin qarr_same1[] = { qcell1, qcell1 };",
    "  Set *qset1 = quadbinset_make(qarr1, 2);",
    "  TSequence *tqseq1 = tquadbinseq_make(qarr_same1, tstzarr1, 2, true, true);",
    "  Temporal *tquadbin1 = (Temporal *) tqseq1;",
    "  /* 5206864856682070015 is the cell 48427fffffffffff as an integer. */",
    "  Temporal *tbigint1 = tbigint_in(\"[5206864856682070015@2001-01-01, 5206864856682070015@2001-01-03]\");",
    "  Temporal *tgeompoint1 = tgeompoint_in(\"SRID=4326;[Point(4.35 50.85)@2001-01-01, Point(4.36 50.86)@2001-01-03]\");",
    "  GSERIALIZED *geom1 = geom_in(\"SRID=4326;Point(4.35 50.85)\", -1);",
    "  Quadbin q_out = 0;",
    "  uint32_t u32_out = 0;",
    "  int n_out = 0;"
  ],
  "cleanup": [
    "  /* tquadbin_unnest hands back its values through a non-final Quadbin **,",
    "   * which the generic emitter reads as an input array, so it is called here",
    "   * and both of its results are released. */",
    "  {",
    "    Quadbin *unnest_values = NULL;",
    "    int unnest_count = 0;",
    "    SpanSet **unnest_spans = tquadbin_unnest(tquadbin1, &unnest_values, &unnest_count);",
    "    printf(\"tquadbin_unnest: n=%d\\n\", unnest_count);",
    "    if (unnest_spans) {",
    "      for (int _i = 0; _i < unnest_count; _i++)",
    "        free(unnest_spans[_i]);",
    "      free(unnest_spans);",
    "    }",
    "    free(unnest_values);",
    "  }",
    "  free(qset1);",
    "  free(tquadbin1);",
    "  free(tbigint1);",
    "  free(tgeompoint1);",
    "  free(geom1);",
    "  free(tstzspan1);"
  ]
}
