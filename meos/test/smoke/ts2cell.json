    "  {",
    "    S2CellId *unnest_values = NULL;",
    "    int unnest_count = 0;",
    "    SpanSet **unnest_spans = ts2cell_unnest(ts2cell1, &unnest_values, &unnest_count);",
    "    printf(\"ts2cell_unnest: n=%d\\n\", unnest_count);",
    "    if (unnest_spans) {",
    "      for (int _i = 0; _i < unnest_count; _i++)",
    "        free(unnest_spans[_i]);",
    "      free(unnest_spans);",
    "    }",
    "    free(unnest_values);",
    "  }",
