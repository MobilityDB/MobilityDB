  "common_inputs": [
    "  TimestampTz tstz1 = timestamptz_in(\"2001-01-01\", -1);",
    "  Span *tstzspan1 = tstzspan_in(\"[2001-01-01, 2001-01-03]\");",
    "  Set *tstzset1 = tstzset_in(\"{2001-01-02, 2001-01-03}\");",
    "  SpanSet *tstzspanset1 = tstzspanset_in(\"{[2001-01-01, 2001-01-02], [2001-01-03, 2001-01-04]}\");",
    "  TimestampTz tstzarr1[] = { timestamptz_in(\"2001-01-01\", -1), timestamptz_in(\"2001-01-03\", -1) };",
    "  /* A cell of level 15 on face 2 and the first of its edge neighbours, which",
    "   * MEOS derives from the cell, so the functions of two cells read neighbours",
    "   * it accepts. */",
    "  S2CellId s2cell1 = s2cell_in(\"47c3c444c0000000\");",
    "  size_t size_out = 0;",
    "  size_t s2wkb1_size = 0;",
    "  uint8_t *s2wkb1 = s2cell_as_wkb(s2cell1, 0, &s2wkb1_size);",
    "  char *s2hexwkb1 = s2cell_as_hexwkb(s2cell1, 0, &size_out);",
    "  int s2count1 = 0;",
    "  S2CellId *s2nbrs1 = s2cell_edge_neighbors(s2cell1, &s2count1);",
    "  S2CellId s2nbr1 = s2nbrs1[0];",
    "  S2CellId s2arr1[] = { s2cell1, s2nbr1 };",
    "  S2CellId s2arr_same1[] = { s2cell1, s2cell1 };",
    "  Set *s2set1 = s2cellset_make(s2arr1, 2);",
    "  TSequence *ts2seq1 = ts2cellseq_make(s2arr_same1, tstzarr1, 2, true, true);",
    "  Temporal *ts2cell1 = (Temporal *) ts2seq1;",
    "  /* The value of a temporal is read off an instant. */",
    "  Temporal *ts2cell_inst1 = (Temporal *) ts2cellinst_make(s2cell1, tstz1);",
    "  char *ts2mfjson1 = temporal_as_mfjson(ts2cell1, 0, 0, 15, NULL);",
    "  /* 5171192596709507072 is the cell 47c3c444c0000000 as an integer. */",
    "  Temporal *tbigint1 = tbigint_in(\"[5171192596709507072@2001-01-01, 5171192596709507072@2001-01-03]\");",
    "  Temporal *tgeogpoint1 = tgeogpoint_in(\"SRID=4326;[Point(4.35 50.85)@2001-01-01, Point(4.36 50.86)@2001-01-03]\");",
    "  Temporal *tgeompoint1 = tgeompoint_in(\"SRID=4326;[Point(4.35 50.85)@2001-01-01, Point(4.36 50.86)@2001-01-03]\");",
    "  GSERIALIZED *geom1 = geom_in(\"SRID=4326;Point(4.35 50.85)\", -1);",
    "  /* The cover of a geography reads its edges as geodesics, so it takes a",
    "   * geodetic point. */",
    "  GSERIALIZED *geog1 = geog_in(\"SRID=4326;Point(4.35 50.85)\", -1);",
    "  S2CellId s2_out = 0;",
    "  int n_out = 0;"
  ],
  "cleanup": [
    "  free(ts2cell_inst1);",
    "  /* ts2cell_unnest hands back its values through a non-final S2CellId **,",
    "   * which the generic emitter reads as an input array, so it is called here",
