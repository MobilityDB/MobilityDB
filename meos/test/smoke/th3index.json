    "TimestampTz *": "tstzarr1",
    "TSequence * *": "(const TSequence **) &th3seq1",
    "Set *": "h3set1",
    "Span *": "tstzspan1",
    "GSERIALIZED *": "geom1",
    "TimestampTz": "tstz1",
    "interpType": "STEP",
    "char *": "\"8a2a1072b59ffff\"",
    "uint8_t *": "h3wkb1",
    "uint8_t": "0",
    "size_t": "h3wkb1_size",
    "size_t *": "&size_out",
    "int *": "&n_out",
    "int": "1",
    "int32": "10",
    "uint32_t": "5",
    "bool": "true"
  },
  "name_arg_map": {
    "^h3index_from_hexwkb$": {"char *": "h3hexwkb1"},
    "^th3index_in$": {"char *": "\"[8a2a1072b59ffff@2001-01-01, 8a2a1072b59ffff@2001-01-03]\""},
    "^th3indexinst_in$": {"char *": "\"8a2a1072b59ffff@2001-01-01\""},
    "^th3indexseq_in$": {"char *": "\"[8a2a1072b59ffff@2001-01-01, 8a2a1072b59ffff@2001-01-03]\""},
    "^th3indexseqset_in$": {"char *": "\"{[8a2a1072b59ffff@2001-01-01, 8a2a1072b59ffff@2001-01-03]}\""},
    "^h3indexset_in$": {"char *": "\"{8a2a1072b59ffff, 880326b885fffff}\""},
    "^h3_is_valid_directed_edge$": {"H3Index": "h3edge1"},
    "^h3_is_valid_vertex$": {"H3Index": "h3vertex1"},
    "directed_edge_(origin|destination|to_boundary)$|^th3index_is_valid_directed_edge$|^th3index_edge_length$": {"Temporal *": "th3index_edge1"},
    "^th3index_(vertex_to_latlng|is_valid_vertex)$": {"Temporal *": "th3index_vertex1"},
    "^tbigint_to_th3index$": {"Temporal *": "tbigint1"},
    "^tgeogpoint_": {"Temporal *": "tgeogpoint1"},
    "^tgeompoint_": {"Temporal *": "tgeompoint1"}
  },
  "override_args": {
    "th3index_are_neighbor_cells": {"1": "th3index_nbr1"},
    "th3index_cells_to_directed_edge": {"1": "th3index_nbr1"},
    "th3index_grid_distance": {"1": "th3index_nbr1"},
    "th3index_cell_to_local_ij": {"1": "th3index_nbr1"},
