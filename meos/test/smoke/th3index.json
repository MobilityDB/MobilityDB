    "th3index_child_pos_to_cell": {"0": "th3index_childpos1", "1": "th3index_parent1", "2": "10"},
    "th3index_cell_to_center_child": {"1": "11"},
    "th3index_cell_to_child_pos": {"1": "9"},
    "th3index_cell_to_vertex": {"1": "0"},
    "h3_cell_to_children": {"1": "11"},
    "h3_uncompact_cells": {"1": "10"},
    "h3_grid_path_cells": {"1": "h3nbr1"},
    "th3indexseq_make": {"0": "h3arr_same1", "2": "2"},
    "h3indexset_make": {"0": "h3arr1", "1": "2"}
  },
  "manual": ["th3index_unnest"],
  "common_inputs": [
    "  TimestampTz tstz1 = timestamptz_in(\"2001-01-01\", -1);",
    "  Span *tstzspan1 = tstzspan_in(\"[2001-01-01, 2001-01-03]\");",
    "  TimestampTz tstzarr1[] = { timestamptz_in(\"2001-01-01\", -1), timestamptz_in(\"2001-01-03\", -1) };",
    "  /* A cell of resolution 10, one of its neighbours, and the directed edge",
    "   * and vertex MEOS itself derives from the cell, so every edge and vertex",
    "   * function reads a value it accepts rather than a guessed literal. */",
    "  H3Index h3cell1 = h3index_in(\"8a2a1072b59ffff\");",
    "  int h3count1 = 0;",
    "  Set *h3ring1 = h3_grid_ring(h3cell1, 1);",
    "  H3Index *h3ring1_values = h3indexset_values(h3ring1, &h3count1);",
    "  H3Index h3nbr1 = h3ring1_values[0];",
    "  Set *h3edges1 = h3_origin_to_directed_edges(h3cell1);",
    "  H3Index *h3edges1_values = h3indexset_values(h3edges1, &h3count1);",
    "  H3Index h3edge1 = h3edges1_values[0];",
    "  Set *h3verts1 = h3_cell_to_vertexes(h3cell1);",
    "  H3Index *h3verts1_values = h3indexset_values(h3verts1, &h3count1);",
    "  H3Index h3vertex1 = h3verts1_values[0];",
    "  H3Index h3arr1[] = { h3cell1, h3nbr1 };",
    "  H3Index h3arr_same1[] = { h3cell1, h3cell1 };",
    "  H3Index h3arr_nbr1[] = { h3nbr1, h3nbr1 };",
    "  Set *h3set1 = h3indexset_make(h3arr1, 2);",
    "  TSequence *th3seq1 = th3indexseq_make(h3arr_same1, tstzarr1, 2, true, true);",
    "  Temporal *th3index1 = (Temporal *) th3seq1;",
    "  Temporal *th3index_nbr1 = (Temporal *) th3indexseq_make(h3arr_nbr1, tstzarr1, 2, true, true);",
    "  Temporal *th3index_edge1 = th3index_cells_to_directed_edge(th3index1, th3index_nbr1);",
    "  Temporal *th3index_vertex1 = th3index_cell_to_vertex(th3index1, 0);",
    "  Temporal *th3index_ij1 = th3index_cell_to_local_ij(th3index1, th3index1);",
    "  Temporal *th3index_childpos1 = th3index_cell_to_child_pos(th3index1, 9);",
    "  Temporal *th3index_parent1 = th3index_cell_to_parent_next(th3index1);",
    "  /* 622236750694711295 is the cell 8a2a1072b59ffff as an integer. */",
    "  Temporal *tbigint1 = tbigint_in(\"[622236750694711295@2001-01-01, 622236750694711295@2001-01-03]\");",
    "  Temporal *tgeogpoint1 = tgeogpoint_in(\"SRID=4326;[Point(4.35 50.85)@2001-01-01, Point(4.36 50.86)@2001-01-03]\");",
    "  Temporal *tgeompoint1 = tgeompoint_in(\"SRID=4326;[Point(4.35 50.85)@2001-01-01, Point(4.36 50.86)@2001-01-03]\");",
    "  GSERIALIZED *geom1 = geom_in(\"SRID=4326;Point(4.35 50.85)\", -1);",
    "  size_t size_out = 0;",
    "  size_t h3wkb1_size = 0;",
    "  uint8_t *h3wkb1 = h3index_as_wkb(h3cell1, 0, &h3wkb1_size);",
    "  char *h3hexwkb1 = h3index_as_hexwkb(h3cell1, 0, &size_out);",
    "  H3Index h3_out = 0;",
    "  int n_out = 0;"
  ],
  "cleanup": [
    "  /* th3index_unnest hands back its values through a non-final H3Index **,",
    "   * which the generic emitter reads as an input array, so it is called here",
    "   * and both of its results are released. */",
    "  {",
    "    H3Index *unnest_values = NULL;",
    "    int unnest_count = 0;",
    "    SpanSet **unnest_spans = th3index_unnest(th3index1, &unnest_values, &unnest_count);",
    "    printf(\"th3index_unnest: n=%d\\n\", unnest_count);",
    "    if (unnest_spans) {",
    "      for (int _i = 0; _i < unnest_count; _i++)",
    "        free(unnest_spans[_i]);",
    "      free(unnest_spans);",
    "    }",
    "    free(unnest_values);",
    "  }",
    "  free(h3ring1_values);",
    "  free(h3ring1);",
    "  free(h3edges1_values);",
    "  free(h3edges1);",
    "  free(h3verts1_values);",
    "  free(h3verts1);",
    "  free(h3set1);",
    "  free(th3index1);",
    "  free(th3index_nbr1);",
    "  free(th3index_edge1);",
    "  free(th3index_vertex1);",
    "  free(th3index_ij1);",
    "  free(th3index_childpos1);",
    "  free(th3index_parent1);",
    "  free(tbigint1);",
    "  free(tgeogpoint1);",
    "  free(tgeompoint1);",
    "  free(geom1);",
    "  free(h3wkb1);",
    "  free(h3hexwkb1);",
    "  free(tstzspan1);"
  ]
}
