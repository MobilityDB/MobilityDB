# Smoke-test sources generated by gen_smoketest.py at run time. Both meos.yml and
# run_smoketests.sh regenerate them from the installed headers before use, so none
# of them is tracked.
/trgeometry_test.c
/tpose_smoketest.c
/tcbuffer_smoketest.c
/tnpoint_smoketest.c
/tgeometry_smoketest.c
/tjsonb_smoketest.c
/temporal_agg_smoketest.c

# Table fixtures exported from the pg_regress archives by
# tools/gen_test_csv.py. mobilitydb/test/<family>/data/load_*.sql.xz is the one
# copy of this data; the CSV form is written from it before the programs that
# read it run, so neither form can drift from the other.
/csv/

# Compiled smoke-test binaries and valgrind logs
/build/
__pycache__/

# Corpus harvested from the GEOS test suite by relate_harvest_geos.py. The WKT
# it carries is the GEOS project's test data under the LGPL 2.1, so it is
# generated on demand rather than tracked.
/relate_corpus_geos.txt
