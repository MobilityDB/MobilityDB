INSERT INTO test_tgeometry_idx(op, no_idx) VALUES ('|=| tgeometry', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeometry_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeometry_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
