-- With no index a plan cannot probe one, whatever the planner settings
SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp << t2.b') AS no_index_probe;
 no_index_probe 
----------------
 f
(1 row)

RESET enable_seqscan;
-------------------------------------------------------------------------------
CREATE INDEX tbl_tgeometry_idx_rtree ON tbl_tgeometry_idx USING gist(temp);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tgeometry_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_tgeometry_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox x';
UPDATE test_tgeometry_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< tgeometry';
UPDATE test_tgeometry_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox';
UPDATE test_tgeometry_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox x';
UPDATE test_tgeometry_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp &< t2.temp)::text,
