  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeometry_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeometry_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn')
