CREATE TABLE test(t) AS
WITH test(t) AS (
  SELECT span(day, day + interval '1 hour')
  FROM generate_series(timestamptz '2001-01-01', timestamptz '2001-04-01', '1 day') AS day )
SELECT spanset(array_agg(t)) FROM test;
SELECT 1
SELECT t::stbox FROM test;
