\getenv srcdir MOBILITYDB_SOURCE_DIR
CREATE TABLE tbl_geography (
    k integer,
    g geography
);
\set filename :srcdir '/mobilitydb/test/geo/data/tbl_geography.data'
COPY tbl_geography (k, g) FROM :'filename';
