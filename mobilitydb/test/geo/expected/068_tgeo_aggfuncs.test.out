(1 row)

WITH temp1(k, inst) AS (
  SELECT 1, tgeometry 'Point(1 1)@2001-01-01' UNION
  SELECT 2, tgeometry 'Point(2 2)@2001-01-02' UNION
  SELECT 3, tgeometry 'Point(3 3)@2001-01-03' UNION
  SELECT 4, tgeometry 'Point(4 4)@2001-01-04' UNION
  SELECT 5, tgeometry 'Point(5 5)@2001-01-05' UNION
  SELECT 6, tgeometry 'Point(6 6)@2001-01-06' UNION
  SELECT 7, tgeometry 'Point(7 7)@2001-01-07' UNION
  SELECT 8, tgeometry 'Point(8 8)@2001-01-08'  ),
temp2(k, seq) AS (
  SELECT k / 3, appendInstant(inst ORDER BY inst)
  FROM temp1
  GROUP BY k / 3)
SELECT astext(appendSequence(seq ORDER BY seq)) FROM temp2;
                                                                                                                                                                     astext                                                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[POINT(1 1)@Mon Jan 01 00:00:00 2001 PST, POINT(2 2)@Tue Jan 02 00:00:00 2001 PST], [POINT(3 3)@Wed Jan 03 00:00:00 2001 PST, POINT(4 4)@Thu Jan 04 00:00:00 2001 PST, POINT(5 5)@Fri Jan 05 00:00:00 2001 PST], [POINT(6 6)@Sat Jan 06 00:00:00 2001 PST, POINT(7 7)@Sun Jan 07 00:00:00 2001 PST, POINT(8 8)@Mon Jan 08 00:00:00 2001 PST]}
(1 row)

WITH temp1(k, inst) AS (
  SELECT 1, tgeography 'Point(1 1)@2001-01-01' UNION
  SELECT 2, tgeography 'Point(2 2)@2001-01-02' UNION
  SELECT 3, tgeography 'Point(3 3)@2001-01-03' UNION
  SELECT 4, tgeography 'Point(4 4)@2001-01-04' UNION
  SELECT 5, tgeography 'Point(5 5)@2001-01-05' UNION
  SELECT 6, tgeography 'Point(6 6)@2001-01-06' UNION
  SELECT 7, tgeography 'Point(7 7)@2001-01-07' UNION
  SELECT 8, tgeography 'Point(8 8)@2001-01-08'  ),
temp2(seq) AS (
  SELECT appendInstant(inst ORDER BY inst)
  FROM temp1
  GROUP BY k / 3)
SELECT astext(appendSequence(seq ORDER BY seq)) FROM temp2;
                                                                                                                                                                     astext                                                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {[POINT(1 1)@Mon Jan 01 00:00:00 2001 PST, POINT(2 2)@Tue Jan 02 00:00:00 2001 PST], [POINT(3 3)@Wed Jan 03 00:00:00 2001 PST, POINT(4 4)@Thu Jan 04 00:00:00 2001 PST, POINT(5 5)@Fri Jan 05 00:00:00 2001 PST], [POINT(6 6)@Sat Jan 06 00:00:00 2001 PST, POINT(7 7)@Sun Jan 07 00:00:00 2001 PST, POINT(8 8)@Mon Jan 08 00:00:00 2001 PST]}
(1 row)

WITH temp1(k, inst) AS (
  SELECT extract(day from d)::int % 2,
    tgeometry(ST_Point(extract(day from d)::int % 2,extract(day from d)::int % 2), d)
  FROM generate_series(timestamptz '1900-01-01', '2001-01-10', interval '1 day') AS d ),
temp2(seq) AS (
  SELECT appendInstant(inst ORDER BY inst)
  FROM temp1
  GROUP BY k / 3)
SELECT numInstants(appendSequence(seq ORDER BY seq)) FROM temp2;
 numinstants 
-------------
       36168
(1 row)

