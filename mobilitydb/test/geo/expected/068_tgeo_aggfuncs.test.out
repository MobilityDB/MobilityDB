/* Errors */
SELECT extent(temp) FROM (VALUES
  (tgeometry 'Point(1 1 1)@2001-01-01'),
  (tgeometry 'Point(1 1)@2001-01-01')) t(temp);
ERROR:  The arguments must be of the same dimensionality
WITH temp(inst) AS (
  SELECT tgeometry 'Point(1 1)@2001-01-01' UNION
  SELECT tgeometry 'Point(2 2)@2001-01-02' UNION
  SELECT tgeometry 'Point(3 3)@2001-01-03' UNION
  SELECT tgeometry 'Point(4 4)@2001-01-04' UNION
  SELECT tgeometry 'Point(5 5)@2001-01-05'  )
SELECT asText(appendInstant(inst ORDER BY inst)) FROM temp;
                                                                                                    astext                                                                                                     
