WITH temp(inst) AS (
  SELECT tgeometry 'Point(1 1 1)@2001-01-01' UNION
  SELECT tgeometry 'Point(2 2 2)@2001-01-02' UNION
  SELECT tgeometry 'Point(2 2 2)@2001-01-04' UNION
  SELECT tgeometry 'Point(5 5 5)@2001-01-05' UNION
