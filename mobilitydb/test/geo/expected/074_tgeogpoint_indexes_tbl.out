  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeogpoint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeogpoint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| stbox';
UPDATE test_tgeogpoint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeogpoint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeogpoint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeogpoint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeogpoint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| tgeogpoint';
UPDATE test_tgeogpoint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeogpoint_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeogpoint_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeogpoint_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeogpoint_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| geography';
RESET enable_seqscan;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_sort;
DROP INDEX tbl_tgeogpoint_idx_kdtree;
