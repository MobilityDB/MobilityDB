INSERT INTO test_tgeompoint_idx(op, no_idx) VALUES ('|=| tgeompoint', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tgeompoint_idx(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
-- With no index a plan cannot probe one, whatever the planner settings
SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeompoint_idx t1, tbl_tgeompoint_box t2 WHERE t1.temp << t2.b') AS no_index_probe;
 no_index_probe 
----------------
 f
(1 row)

RESET enable_seqscan;
-------------------------------------------------------------------------------
CREATE INDEX tbl_tgeompoint_idx_rtree ON tbl_tgeompoint_idx USING gist(temp);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
