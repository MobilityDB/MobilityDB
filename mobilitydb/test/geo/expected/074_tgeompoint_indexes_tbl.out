INSERT INTO test_tgeompoint_idx(op, no_idx) VALUES ('stbox <<# tgeompoint', (SELECT COUNT(*) FROM tbl_tgeompoint_box t2, tbl_tgeompoint_idx t1 WHERE t2.b <<# t1.temp)::text);
