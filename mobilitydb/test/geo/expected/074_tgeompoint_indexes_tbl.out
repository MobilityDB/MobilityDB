-- Every row carries the same value, so a split of the quad-tree finds keys that
-- are all equal
CREATE TEMP TABLE tbl_tgeompoint_allthesame AS
SELECT k, tgeompoint(geometry 'Point(5 5)', t) AS temp
FROM tbl_tstzspan_big;
CREATE INDEX tbl_tgeompoint_allthesame_quadtree ON tbl_tgeompoint_allthesame USING spgist(temp);
SELECT COUNT(*) AS rows_scan FROM tbl_tgeompoint_allthesame WHERE temp && (SELECT temp::stbox FROM tbl_tgeompoint_allthesame LIMIT 1);
 rows_scan 
-----------
         1
(1 row)

SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeompoint_allthesame WHERE temp && (SELECT temp::stbox FROM tbl_tgeompoint_allthesame LIMIT 1)') AS probe;
