  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeompoint3d_box t2, tbl_tgeompoint3d_idx t1 WHERE t2.b <</ t1.temp')
WHERE op = 'stbox <</ tgeompoint';
UPDATE test_tgeompoint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeompoint3d_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeompoint3d_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeompoint3d_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeompoint3d_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| stbox';
UPDATE test_tgeompoint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeompoint3d_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeompoint3d_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeompoint3d_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeompoint3d_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| tgeompoint';
UPDATE test_tgeompoint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tgeompoint3d_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeompoint3d_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tgeompoint3d_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeompoint3d_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| geometry';
RESET enable_seqscan;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_sort;
DROP INDEX tbl_tgeompoint3d_idx_kdtree;
