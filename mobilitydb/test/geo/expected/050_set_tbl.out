-- Distance
-------------------------------------------------------------------------------
SELECT round(setDistance(geometry 'Point(1 1)', geomset '{"Point(4 5)", "Point(10 10)"}')::numeric, 6);
  round   
----------
 5.000000
(1 row)

SELECT round(setDistance(geomset '{"Point(4 5)", "Point(10 10)"}', geometry 'Point(1 1)')::numeric, 6);
  round   
----------
 5.000000
(1 row)

SELECT round(setDistance(geomset '{"Point(1 1)"}', geomset '{"Point(4 5)"}')::numeric, 6);
  round   
----------
 5.000000
(1 row)

SELECT round((geometry 'Point(1 1)' <-> geomset '{"Point(4 5)", "Point(10 10)"}')::numeric, 6);
  round   
----------
 5.000000
(1 row)

SELECT round(setDistance(geography 'Point(1 1)', geogset '{"Point(1 1)", "Point(2 2)"}')::numeric, 6);
  round   
----------
 0.000000
(1 row)

SELECT round(setDistance(geogset '{"Point(1 1)", "Point(2 2)"}', geography 'Point(1 1)')::numeric, 6);
  round   
----------
 0.000000
(1 row)

-------------------------------------------------------------------------------
-- One degree of meridian near the equator measures about 110575 m on the spheroid and 111195 m on the sphere
SELECT round(setDistance(geography 'Point(0 0)', geogset '{"Point(0 1)", "Point(0 2)"}')::numeric, 3);
   round    
------------
 110574.389
(1 row)

SELECT round(setDistance(geography 'Point(0 0)', geogset '{"Point(0 1)", "Point(0 2)"}', false)::numeric, 3);
   round    
------------
 111195.080
(1 row)

SELECT round(setDistance(geogset '{"Point(0 1)", "Point(0 2)"}', geography 'Point(0 0)')::numeric, 3);
   round    
------------
 110574.389
(1 row)

SELECT round(setDistance(geogset '{"Point(0 1)", "Point(0 2)"}', geography 'Point(0 0)', false)::numeric, 3);
   round    
------------
 111195.080
(1 row)

SELECT round(setDistance(geogset '{"Point(0 1)"}', geogset '{"Point(0 0)"}')::numeric, 3);
   round    
------------
 110574.389
(1 row)

SELECT round(setDistance(geogset '{"Point(0 1)"}', geogset '{"Point(0 0)"}', false)::numeric, 3);
   round    
------------
 111195.080
(1 row)

-- A set of geographies answers for the region of the longitudes and latitudes
-- of its box: a geography above that region, though inside the polygon of the
-- corners of the box, lies at the distance along its meridian to the top
-- parallel, as the point on that parallel answers it on the spheroid
SELECT round((geogset '{"Point(28.57 56.03)", "Point(79.16 21.19)"}' <->
  geography 'Point(67.99 57.83)')::numeric, 3);
   round    
------------
 200445.451
(1 row)

SELECT round(ST_Distance(geography 'Point(67.99 56.03)',
  geography 'Point(67.99 57.83)')::numeric, 3);
   round    
------------
 200445.451
(1 row)

-- Two sets of geographies whose longitudes are apart meet on facing meridians
SELECT round((geogset '{"Point(0 40)", "Point(10 50)"}' <->
  geogset '{"Point(30 60)", "Point(40 70)"}')::numeric, 3);
    round    
-------------
 1684220.181
(1 row)

SELECT round(ST_Distance(geography 'Point(10 50)',
  geography 'Point(30 60)')::numeric, 3);
    round    
-------------
 1684220.181
(1 row)

-- A geo set casts to the collection of its values, as ST_Collect builds it from
-- them, a set of one point answering a multipoint
SELECT ST_AsText(geometry(geomset '{"Point(1 1)", "Point(2 2)"}'));
        st_astext        
-------------------------
 MULTIPOINT((1 1),(2 2))
(1 row)

SELECT ST_AsText(geomset '{"Point(1 1)"}'::geometry);
     st_astext     
-------------------
 MULTIPOINT((1 1))
(1 row)

SELECT ST_AsText(geometry(geomset '{"Point(1 1)", "Linestring(0 0,1 1)"}'));
                     st_astext                      
----------------------------------------------------
 GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 1))
(1 row)

SELECT ST_AsText(geography(geogset '{"Point(1 1)", "Point(2 2)"}'));
        st_astext        
-------------------------
 MULTIPOINT((1 1),(2 2))
(1 row)

SELECT ST_AsText(geomset '{"Point(1 1)", "Point(2 2)"}'::geometry) =
  ST_AsText(ST_Collect(ARRAY[geometry 'Point(1 1)', geometry 'Point(2 2)']));
 ?column? 
----------
 t
(1 row)

