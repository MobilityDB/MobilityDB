SELECT geometry 'POINT empty'::tgeompoint;
ERROR:  Only non-empty geometries accepted
SELECT geometry 'POINT(1 1)'::tgeompoint;
ERROR:  The geometry must have M dimension
SELECT geometry 'POLYGON M((1 1 978303600,1 2 978303600,2 2 978303600,2 1 978303600,1 1 978303600))'::tgeompoint;
ERROR:  Invalid geometry type for trajectory
SELECT geometry 'MULTIPOINT M (1 1 978390000,1 1 978303600)'::tgeompoint;
