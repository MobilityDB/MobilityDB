/* Geographies */
WITH g(geog) AS (VALUES
  (geography 'Point(4.35 50.85)'),
  (geography 'Linestring(4.35 50.85,2.35 48.85)'),
  (geography 'SRID=4269;Polygon((0 0,1 0,1 1,0 1,0 0))'),
  (geography 'Point empty'))
SELECT
  count(*) FILTER (WHERE asText(geog) IS DISTINCT FROM ST_AsText(geog)) AS astext,
  count(*) FILTER (WHERE asEWKT(geog) IS DISTINCT FROM ST_AsEWKT(geog)) AS asewkt,
  count(*) FILTER (WHERE asEWKB(geog) IS DISTINCT FROM ST_AsEWKB(geog::geometry)) AS asewkb,
  count(*) FILTER (WHERE asGeoJSON(geog) IS DISTINCT FROM ST_AsGeoJSON(geog)) AS asgeojson,
  count(*) FILTER (WHERE asGeoJSON(geog, 9, 1) IS DISTINCT FROM ST_AsGeoJSON(geog, 9, 1)) AS asgeojson1
FROM g;
