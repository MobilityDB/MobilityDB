WITH g(id, geom) AS (VALUES
  (1, geometry 'Polygon((0 0,4 0,4 4,0 4,0 0))'),
  (2, geometry 'Point(2 2)'),
  (3, geometry 'Point(4 2)'),
  (4, geometry 'Point(5 5)'),
  (5, geometry 'Linestring(2 2,6 2)'),
  (6, geometry 'Polygon((1 1,2 1,2 2,1 2,1 1))'),
  (7, geometry 'Polygon((4 0,6 0,6 4,4 4,4 0))'),
  (8, geometry 'Linestring(0 0,4 0)'),
  (9, geometry 'MultiPoint(1 1,5 5)'),
  (10, geometry 'Polygon((2 2,6 2,6 6,2 6,2 2))'),
  (11, geometry 'Point empty'),
  (12, geometry 'Linestring Z(1.123456789 2.5 3,4 5.25 6)'),
  (13, geometry 'CircularString(0 0,1 1,2 0)'),
  (14, geometry 'SRID=3857;Point(1.123456789 2)'),
  (15, geometry 'SRID=4326;Linestring(1 1,2 2)'))
SELECT
  count(*) FILTER (WHERE asText(geom) IS DISTINCT FROM ST_AsText(geom)) AS astext,
  count(*) FILTER (WHERE asText(geom, 3) IS DISTINCT FROM ST_AsText(geom, 3)) AS astext3,
  count(*) FILTER (WHERE asEWKT(geom) IS DISTINCT FROM ST_AsEWKT(geom)) AS asewkt,
  count(*) FILTER (WHERE asEWKT(geom, 3) IS DISTINCT FROM ST_AsEWKT(geom, 3)) AS asewkt3,
  count(*) FILTER (WHERE asEWKB(geom) IS DISTINCT FROM ST_AsEWKB(geom)) AS asewkb,
  count(*) FILTER (WHERE asEWKB(geom, 'XDR') IS DISTINCT FROM ST_AsEWKB(geom, 'XDR')) AS asewkbxdr,
  count(*) FILTER (WHERE asEWKB(geom, 'NDR') IS DISTINCT FROM ST_AsEWKB(geom, 'NDR')) AS asewkbndr
FROM g;
