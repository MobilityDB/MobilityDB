/* The GeoJSON of the same geometries but the arc, which GeoJSON cannot state */
WITH g(id, geom) AS (VALUES
  (1, geometry 'Polygon((0 0,4 0,4 4,0 4,0 0))'),
  (2, geometry 'Point(2 2)'),
  (5, geometry 'Linestring(2 2,6 2)'),
  (9, geometry 'MultiPoint(1 1,5 5)'),
  (11, geometry 'Point empty'),
  (12, geometry 'Linestring Z(1.123456789 2.5 3,4 5.25 6)'),
  (14, geometry 'SRID=3857;Point(1.123456789 2)'),
  (15, geometry 'SRID=4326;Linestring(1 1,2 2)'))
SELECT
  count(*) FILTER (WHERE asGeoJSON(geom) IS DISTINCT FROM ST_AsGeoJSON(geom)) AS asgeojson,
  count(*) FILTER (WHERE asGeoJSON(geom, 4, 0) IS DISTINCT FROM ST_AsGeoJSON(geom, 4, 0)) AS asgeojson0,
  count(*) FILTER (WHERE asGeoJSON(geom, 9, 1) IS DISTINCT FROM ST_AsGeoJSON(geom, 9, 1)) AS asgeojson1,
  count(*) FILTER (WHERE asGeoJSON(geom, 9, 2) IS DISTINCT FROM ST_AsGeoJSON(geom, 9, 2)) AS asgeojson2,
  count(*) FILTER (WHERE asGeoJSON(geom, 9, 4) IS DISTINCT FROM ST_AsGeoJSON(geom, 9, 4)) AS asgeojson4,
  count(*) FILTER (WHERE asGeoJSON(geom, 9, 7) IS DISTINCT FROM ST_AsGeoJSON(geom, 9, 7)) AS asgeojson7
FROM g;
 asgeojson | asgeojson0 | asgeojson1 | asgeojson2 | asgeojson4 | asgeojson7 
-----------+------------+------------+------------+------------+------------
         0 |          0 |          0 |          0 |          0 |          0
(1 row)

