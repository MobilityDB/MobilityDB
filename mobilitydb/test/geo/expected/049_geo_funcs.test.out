/* The transformation of a geometry and of a geography, byte for byte */
WITH g(geom, srid) AS (VALUES
  (geometry 'SRID=4326;Point(4.35 50.85)', 3857),
  (geometry 'SRID=4326;Point(4.35 50.85)', 3812),
  (geometry 'SRID=4326;Linestring(4.35 50.85,2.35 48.85)', 2154),
  (geometry 'SRID=4326;Polygon((4 50,5 50,5 51,4 51,4 50))', 32631),
  (geometry 'SRID=3857;Point(484245.3 6594434.7)', 4326),
  (geometry 'SRID=4326;Point Z(4.35 50.85 100)', 4978),
  (geometry 'SRID=4326;Point(4.35 50.85)', 4326),
  (geometry 'SRID=4326;Point empty', 3857))
SELECT count(*) FILTER (WHERE ST_AsEWKB(transform(geom, srid)) IS DISTINCT FROM
  ST_AsEWKB(ST_Transform(geom, srid))) AS transform
FROM g;
 transform 
-----------
         0
(1 row)

