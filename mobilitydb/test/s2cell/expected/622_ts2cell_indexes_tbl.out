RESET enable_seqscan;
DROP TABLE tbl_stbox_ts2cell, tbl_ts2cell_q, tbl_stbox_ts2cell_seq;
DROP FUNCTION pg_temp.stbox_ts2cell_indexed(), pg_temp.stbox_ts2cell_answers(), pg_temp.stbox_ts2cell_probes_index(text);
