-- Every row carries the same value, so a split of the quad-tree finds keys that
-- are all equal
CREATE TEMP TABLE tbl_ts2cell_allthesame AS
SELECT k, ts2cell(s2cell '4fb119', t) AS temp
FROM tbl_tstzspan_big;
CREATE INDEX tbl_ts2cell_allthesame_quadtree ON tbl_ts2cell_allthesame USING spgist(temp);
