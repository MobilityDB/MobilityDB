-------------------------------------------------------------------------------
-- The R-tree GiST, quad-tree and k-d tree SP-GiST indexes of a ts2cell, keyed by
-- the stbox of the value. Under each index every operator of the class, with each
-- right argument it declares, answers the rows a sequential scan gives, from a
-- plan that probes the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_ts2cell_idx;
NOTICE:  table "tbl_ts2cell_idx" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_idx AS
WITH base(k, temp) AS (
  SELECT k, temp FROM tbl_ts2cell_big
  UNION ALL
  SELECT k + 10100, temp FROM tbl_ts2cell_inst
  UNION ALL
  SELECT k + 10200, temp FROM tbl_ts2cell_discseq
  UNION ALL
  SELECT k + 10300, temp FROM tbl_ts2cell_contseq
  UNION ALL
  SELECT k + 10400, temp FROM tbl_ts2cell_seqset )
SELECT k + n * 10500 AS k, shiftTime(temp, n * interval '1 week') AS temp
FROM base, generate_series(0, 0) AS n;
ANALYZE tbl_ts2cell_idx;
-- The values, boxes and periods the operators are given. Those of the fixture
-- are random, so they meet few values exactly: the others come from the rows of
-- the table, so that every operator has rows to answer.
DROP TABLE IF EXISTS tbl_ts2cell_src;
NOTICE:  table "tbl_ts2cell_src" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_src AS
SELECT k, temp, temp::stbox AS b, temp::tstzspan AS t
FROM tbl_ts2cell_idx WHERE k % 1000 = 0;
-- A value of the fixture, a value of the table, and one whose period ends where
-- that of the value starts. The search for the nearest values, whose distance
-- costs more than a box, is given the second alone.
DROP TABLE IF EXISTS tbl_ts2cell_val;
NOTICE:  table "tbl_ts2cell_val" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_val AS
SELECT temp, false AS knn FROM tbl_ts2cell WHERE k % 20 = 0
UNION ALL
SELECT temp, true FROM tbl_ts2cell_src
UNION ALL
SELECT shiftTime(temp, lower(t) - upper(t)), false FROM tbl_ts2cell_src;
ANALYZE tbl_ts2cell_val;
-- The box of a value of the fixture, the box of a value, one around it, one
-- inside it, and one whose period meets it
DROP TABLE IF EXISTS tbl_ts2cell_box;
NOTICE:  table "tbl_ts2cell_box" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_box AS
SELECT temp::stbox AS b, false AS knn FROM tbl_ts2cell WHERE k % 20 = 0
UNION ALL
SELECT b, true FROM tbl_ts2cell_src
UNION ALL
SELECT expandTime(expandSpace(b, 0.1), interval '1 day'), false FROM tbl_ts2cell_src
UNION ALL
SELECT stbox(format('SRID=4326;GEODSTBOX XT(((%s,%s),(%s,%s)),[%s,%s])',
    (xmin(b) + xmax(b)) / 2, (ymin(b) + ymax(b)) / 2, (xmin(b) + xmax(b)) / 2 + 0.000001, (ymin(b) + ymax(b)) / 2 + 0.000001,
    lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2)), false
FROM tbl_ts2cell_src
UNION ALL
SELECT stbox(format('SRID=4326;GEODSTBOX XT(((%s,%s),(%s,%s)),[%s,%s%s)',
    xmin(b), ymin(b), xmax(b), ymax(b), lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END)), false
FROM tbl_ts2cell_src;
ANALYZE tbl_ts2cell_box;
-- A box of space alone, which the operators on time refuse: one around a value,
-- one inside it, the space of a value, and one that meets it
DROP TABLE IF EXISTS tbl_ts2cell_xbox;
NOTICE:  table "tbl_ts2cell_xbox" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_xbox AS
SELECT stbox(format('SRID=4326;GEODSTBOX X((%s,%s),(%s,%s))',
    xmin(b) - 0.1, ymin(b) - 0.1, xmax(b) + 0.1, ymax(b) + 0.1)) AS b
FROM tbl_ts2cell_src
UNION ALL
SELECT stbox(format('SRID=4326;GEODSTBOX X((%s,%s),(%s,%s))',
    (xmin(b) + xmax(b)) / 2, (ymin(b) + ymax(b)) / 2, (xmin(b) + xmax(b)) / 2 + 0.000001, (ymin(b) + ymax(b)) / 2 + 0.000001)) AS b
FROM tbl_ts2cell_src
UNION ALL
SELECT stbox(format('SRID=4326;GEODSTBOX X((%s,%s),(%s,%s))',
    xmin(b), ymin(b), xmax(b), ymax(b))) AS b
FROM tbl_ts2cell_src
UNION ALL
SELECT stbox(format('SRID=4326;GEODSTBOX X((%s,%s),(%s,%s))',
    xmax(b), ymin(b), xmax(b) + 0.1, ymax(b))) AS b
FROM tbl_ts2cell_src;
ANALYZE tbl_ts2cell_xbox;
-- A period of the fixture, the period of a value, one around it, one inside it,
-- and one that meets it
DROP TABLE IF EXISTS tbl_ts2cell_span;
NOTICE:  table "tbl_ts2cell_span" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_span AS
SELECT t FROM tbl_tstzspan WHERE k % 20 = 0
UNION ALL
SELECT t FROM tbl_ts2cell_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) - interval '1 day', upper(t) + interval '1 day'))
FROM tbl_ts2cell_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2))
FROM tbl_ts2cell_src
UNION ALL
SELECT tstzspan(format('[%s, %s%s', lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END))
FROM tbl_ts2cell_src;
ANALYZE tbl_ts2cell_span;
-- A point at a corner of the box of a value
DROP TABLE IF EXISTS tbl_ts2cell_geo;
NOTICE:  table "tbl_ts2cell_geo" does not exist, skipping
CREATE TEMP TABLE tbl_ts2cell_geo AS
SELECT ST_SetSRID(ST_MakePoint(xmin(b), ymin(b)), 4326) AS g, true AS knn FROM tbl_ts2cell_src;
ANALYZE tbl_ts2cell_geo;
DROP TABLE IF EXISTS test_ts2cell_idx;
NOTICE:  table "test_ts2cell_idx" does not exist, skipping
CREATE TEMP TABLE test_ts2cell_idx(op text, no_idx text, rtree_idx text, quadtree_idx text,
  kdtree_idx text, rtree_probe boolean, quadtree_probe boolean,
  kdtree_probe boolean);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('<< stbox', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp << t2.b)::text);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('<< stbox x', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp << t2.b)::text);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('<< ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp << t2.temp)::text);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('&< stbox', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp &< t2.b)::text);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('&< stbox x', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp &< t2.b)::text);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('&< ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp &< t2.temp)::text);
INSERT INTO test_ts2cell_idx(op, no_idx) VALUES ('&& tstzspan', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_span t2 WHERE t1.temp && t2.t)::text);
