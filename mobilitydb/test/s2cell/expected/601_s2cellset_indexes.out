  rtree_probe = test_probes_index('SELECT COUNT(*) FROM tbl_s2cellset_idx t1, (SELECT startValue(s) AS v FROM tbl_s2cellset_idx) t2 WHERE t1.s @> t2.v')
WHERE op = '@> value';
