CREATE TABLE test_s2cellset_idx(op text, no_idx text, rtree_idx text, quadtree_idx text,
  kdtree_idx text, rtree_probe boolean, quadtree_probe boolean,
  kdtree_probe boolean);
CREATE TABLE
INSERT INTO test_s2cellset_idx(op, no_idx) VALUES ('&&', (SELECT COUNT(*) FROM tbl_s2cellset_idx t1, tbl_s2cellset_idx t2 WHERE t1.s && t2.s)::text);
INSERT 0 1
INSERT INTO test_s2cellset_idx(op, no_idx) VALUES ('=', (SELECT COUNT(*) FROM tbl_s2cellset_idx t1, tbl_s2cellset_idx t2 WHERE t1.s = t2.s)::text);
INSERT 0 1
INSERT INTO test_s2cellset_idx(op, no_idx) VALUES ('@> set', (SELECT COUNT(*) FROM tbl_s2cellset_idx t1, tbl_s2cellset_idx t2 WHERE t1.s @> t2.s)::text);
INSERT 0 1
INSERT INTO test_s2cellset_idx(op, no_idx) VALUES ('<@', (SELECT COUNT(*) FROM tbl_s2cellset_idx t1, tbl_s2cellset_idx t2 WHERE t1.s <@ t2.s)::text);
INSERT 0 1
INSERT INTO test_s2cellset_idx(op, no_idx) VALUES ('@> value', (SELECT COUNT(*) FROM tbl_s2cellset_idx t1, (SELECT startValue(s) AS v FROM tbl_s2cellset_idx) t2 WHERE t1.s @> t2.v)::text);
INSERT 0 1
