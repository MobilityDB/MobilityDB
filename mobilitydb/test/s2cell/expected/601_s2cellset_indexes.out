CREATE FUNCTION test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
CREATE FUNCTION
DROP TABLE IF EXISTS tbl_s2cellset_idx;
NOTICE:  table "tbl_s2cellset_idx" does not exist, skipping
DROP TABLE
CREATE TABLE tbl_s2cellset_idx AS
WITH src AS (
SELECT k, set(ARRAY[
  geoToS2Cell(geography(ST_SetSRID(ST_MakePoint(4.0 + (k % 20) * 0.05,
    50.0 + (k / 20) * 0.05), 4326)), 12),
  geoToS2Cell(geography(ST_SetSRID(ST_MakePoint(4.02 + (k % 20) * 0.05,
    50.02 + (k / 20) * 0.05), 4326)), 12)]) AS s
FROM generate_series(1, 200) k)
SELECT k, s FROM src
UNION ALL
SELECT t1.k + 100000, t1.s + t2.s FROM src t1, src t2 WHERE t2.k = t1.k + 1;
SELECT 399
ANALYZE tbl_s2cellset_idx;
ANALYZE
