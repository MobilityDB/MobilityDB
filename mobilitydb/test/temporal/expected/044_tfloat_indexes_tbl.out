-- Every row carries the same value, so a split of the quad-tree finds keys that
-- are all equal
CREATE TEMP TABLE tbl_tfloat_allthesame AS
SELECT k, tfloat(float '5.5', t) AS temp
FROM tbl_tstzspan_big;
CREATE INDEX tbl_tfloat_allthesame_quadtree ON tbl_tfloat_allthesame USING spgist(temp);
SELECT COUNT(*) AS rows_scan FROM tbl_tfloat_allthesame WHERE temp && tbox 'TBOXFLOAT X([5.5, 5.5])';
 rows_scan 
-----------
     12380
(1 row)

SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_allthesame WHERE temp && tbox ''TBOXFLOAT X([5.5, 5.5])''') AS probe;
