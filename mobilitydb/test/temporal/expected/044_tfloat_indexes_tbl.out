INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('-|- tstzspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp -|- t2.t)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('-|- floatspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp -|- t2.v)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('-|- tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp -|- t2.b)::text);
