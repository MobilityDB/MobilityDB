INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox << tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b << t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tstzspan ~= tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t ~= t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox ~= tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b ~= t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tstzspan <@ tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t <@ t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox <@ tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b <@ t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tstzspan @> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t @> t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox @> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b @> t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tstzspan -|- tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t -|- t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox -|- tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b -|- t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tstzspan #>> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t #>> t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox #>> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b #>> t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tstzspan <<# tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('tbox <<# tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('|=| floatspan', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tfloat_vspan t2, LATERAL (SELECT t1.temp |=| t2.v AS d FROM tbl_tfloat_idx t1 ORDER BY t1.temp |=| t2.v LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('|=| tbox', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tfloat_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tfloat_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tfloat_idx(op, no_idx) VALUES ('|=| tfloat', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tfloat_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tfloat_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
-- With no index a plan cannot probe one, whatever the planner settings
SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp << t2.b') AS no_index_probe;
 no_index_probe 
----------------
 f
(1 row)

RESET enable_seqscan;
-------------------------------------------------------------------------------
CREATE INDEX tbl_tfloat_idx_rtree ON tbl_tfloat_idx USING gist(temp);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp << t2.v)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp << t2.v')
WHERE op = '<< floatspan';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< tbox';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< tbox x';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< tfloat';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &< t2.v)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &< t2.v')
WHERE op = '&< floatspan';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< tbox';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< tbox x';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &< t2.temp)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &< t2.temp')
WHERE op = '&< tfloat';
UPDATE test_tfloat_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp && t2.t)::text,
