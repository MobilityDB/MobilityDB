-------------------------------------------------------------------------------
-- Exclusion constraints
-------------------------------------------------------------------------------
CREATE TEMP TABLE tbl_datespanset_excl (k int, d datespanset,
  EXCLUDE USING gist (d WITH &&));
INSERT INTO tbl_datespanset_excl VALUES
  (1, '{[2001-01-01, 2001-01-05), [2001-01-10, 2001-01-15)}'),
  (2, '{[2001-01-05, 2001-01-10)}');
/* Errors */
INSERT INTO tbl_datespanset_excl VALUES (3, '{[2001-01-12, 2001-01-20)}');
ERROR:  conflicting key value violates exclusion constraint "tbl_datespanset_excl_d_excl"
DETAIL:  Key (d)=({[01-12-2001, 01-20-2001)}) conflicts with existing key (d)=({[01-01-2001, 01-05-2001), [01-10-2001, 01-15-2001)}).
SELECT k, d FROM tbl_datespanset_excl ORDER BY k;
 k |                          d                           
---+------------------------------------------------------
 1 | {[01-01-2001, 01-05-2001), [01-10-2001, 01-15-2001)}
 2 | {[01-05-2001, 01-10-2001)}
(2 rows)

DROP TABLE tbl_datespanset_excl;
CREATE TEMP TABLE tbl_tstzspanset_excl (k int, t tstzspanset,
  EXCLUDE USING gist (t WITH &&));
INSERT INTO tbl_tstzspanset_excl VALUES
  (1, '{[2001-01-01, 2001-01-05), [2001-01-10, 2001-01-15)}'),
  (2, '{[2001-01-05, 2001-01-10)}');
/* Errors */
INSERT INTO tbl_tstzspanset_excl VALUES (3, '{[2001-01-12, 2001-01-20)}');
ERROR:  conflicting key value violates exclusion constraint "tbl_tstzspanset_excl_t_excl"
DETAIL:  Key (t)=({[Fri Jan 12 00:00:00 2001 PST, Sat Jan 20 00:00:00 2001 PST)}) conflicts with existing key (t)=({[Mon Jan 01 00:00:00 2001 PST, Fri Jan 05 00:00:00 2001 PST), [Wed Jan 10 00:00:00 2001 PST, Mon Jan 15 00:00:00 2001 PST)}).
SELECT COUNT(*) FROM tbl_tstzspanset_excl;
 count 
-------
     2
(1 row)

DROP TABLE tbl_tstzspanset_excl;
CREATE TEMP TABLE tbl_datespan_excl (k int, d datespan,
  EXCLUDE USING gist (d WITH &&));
INSERT INTO tbl_datespan_excl VALUES
  (1, '[2001-01-01, 2001-01-05)'), (2, '[2001-01-05, 2001-01-10)');
/* Errors */
INSERT INTO tbl_datespan_excl VALUES (3, '[2001-01-06, 2001-01-08)');
ERROR:  conflicting key value violates exclusion constraint "tbl_datespan_excl_d_excl"
DETAIL:  Key (d)=([01-06-2001, 01-08-2001)) conflicts with existing key (d)=([01-05-2001, 01-10-2001)).
SELECT COUNT(*) FROM tbl_datespan_excl;
 count 
-------
     2
(1 row)

DROP TABLE tbl_datespan_excl;
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- The nearest span sets of dates and of timestamps, read through the GiST index
CREATE TEMP TABLE tbl_datespanset AS TABLE tbl_datespanset;
CREATE TEMP TABLE tbl_tstzspanset AS TABLE tbl_tstzspanset;
ANALYZE tbl_datespanset, tbl_tstzspanset;
CREATE INDEX tbl_datespanset_rtree_idx ON tbl_datespanset USING GIST(d);
CREATE INDEX tbl_tstzspanset_rtree_idx ON tbl_tstzspanset USING GIST(t);
SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT d <-> date '2001-06-01' FROM tbl_datespanset
  ORDER BY d <-> date '2001-06-01' LIMIT 3;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Limit
   ->  Index Scan using tbl_datespanset_rtree_idx on tbl_datespanset
         Order By: (d <-> '06-01-2001'::date)
(3 rows)

SELECT d <-> date '2001-06-01' FROM tbl_datespanset
  ORDER BY d <-> date '2001-06-01' LIMIT 3;
 ?column? 
----------
        0
        0
        0
(3 rows)

EXPLAIN (COSTS OFF) SELECT t <-> timestamptz '2001-06-01' FROM tbl_tstzspanset
  ORDER BY t <-> timestamptz '2001-06-01' LIMIT 3;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using tbl_tstzspanset_rtree_idx on tbl_tstzspanset
         Order By: (t <-> 'Fri Jun 01 00:00:00 2001 PDT'::timestamp with time zone)
(3 rows)

SELECT t <-> timestamptz '2001-06-01' FROM tbl_tstzspanset
  ORDER BY t <-> timestamptz '2001-06-01' LIMIT 3;
         ?column?          
---------------------------
 @ 1 day 12 hours 50 mins
 @ 2 days 14 hours 24 mins
 @ 2 days 20 hours 19 mins
(3 rows)

RESET enable_seqscan;
DROP INDEX tbl_datespanset_rtree_idx;
DROP INDEX tbl_tstzspanset_rtree_idx;
-------------------------------------------------------------------------------
