-------------------------------------------------------------------------------
-- File timeops.c
-- Tests of operators that do involve indexes for time types.
-------------------------------------------------------------------------------
-- This test creates its indexes on copies of the tables of the setup scripts,
-- which hide those tables in its session: every test reads them, and an
-- index on them would change the plans of the other tests.
CREATE TEMP TABLE tbl_tstzspan_big AS TABLE tbl_tstzspan_big;
CREATE TEMP TABLE tbl_tstzspanset_big AS TABLE tbl_tstzspanset_big;
ANALYZE tbl_tstzspan_big, tbl_tstzspanset_big;
DROP INDEX IF EXISTS tbl_tstzspanset_big_quadtree_idx;
NOTICE:  index "tbl_tstzspanset_big_quadtree_idx" does not exist, skipping
DROP INDEX IF EXISTS tbl_tstzspan_big_quadtree_idx;
NOTICE:  index "tbl_tstzspan_big_quadtree_idx" does not exist, skipping
-------------------------------------------------------------------------------
CREATE INDEX tbl_tstzspan_big_quadtree_idx ON tbl_tstzspan_big USING SPGIST(t);
CREATE INDEX tbl_tstzspanset_big_quadtree_idx ON tbl_tstzspanset_big USING SPGIST(t);
