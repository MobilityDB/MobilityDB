INSERT INTO test_tint_idx(op, no_idx) VALUES ('tbox ~= tint', (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b ~= t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tstzspan <@ tint', (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t <@ t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tbox <@ tint', (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b <@ t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tstzspan @> tint', (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t @> t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tbox @> tint', (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b @> t1.temp)::text);
