UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b ~= t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b ~= t1.temp')
WHERE op = 'tbox ~= tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t <@ t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t <@ t1.temp')
WHERE op = 'tstzspan <@ tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b <@ t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b <@ t1.temp')
WHERE op = 'tbox <@ tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t @> t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t @> t1.temp')
WHERE op = 'tstzspan @> tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b @> t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b @> t1.temp')
WHERE op = 'tbox @> tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t -|- t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t -|- t1.temp')
WHERE op = 'tstzspan -|- tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b -|- t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b -|- t1.temp')
WHERE op = 'tbox -|- tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t #>> t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t #>> t1.temp')
WHERE op = 'tstzspan #>> tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b #>> t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b #>> t1.temp')
WHERE op = 'tbox #>> tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t <<# t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t <<# t1.temp')
WHERE op = 'tstzspan <<# tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b <<# t1.temp)::text,
  kdtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b <<# t1.temp')
WHERE op = 'tbox <<# tint';
UPDATE test_tint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tint_vspan t2, LATERAL (SELECT t1.temp |=| t2.v AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.v LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tint_vspan t2, LATERAL (SELECT t1.temp |=| t2.v AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.v LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| intspan';
UPDATE test_tint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| tbox';
UPDATE test_tint_idx SET kdtree_idx = (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn),
  kdtree_probe = pg_temp.test_probes_index('SELECT string_agg(s.d::text, '','' ORDER BY s.d) FROM tbl_tint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| tint';
RESET enable_seqscan;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_sort;
DROP INDEX tbl_tint_idx_kdtree;
