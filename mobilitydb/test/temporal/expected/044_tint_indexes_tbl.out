INSERT INTO test_tint_idx(op, no_idx) VALUES ('#>> tstzspan', (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_span t2 WHERE t1.temp #>> t2.t)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('#>> tbox', (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_box t2 WHERE t1.temp #>> t2.b)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('#>> tint', (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_val t2 WHERE t1.temp #>> t2.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('#&> tstzspan', (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_span t2 WHERE t1.temp #&> t2.t)::text);
