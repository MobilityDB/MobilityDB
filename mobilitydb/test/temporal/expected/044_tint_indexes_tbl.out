INSERT INTO test_tint_idx(op, no_idx) VALUES ('tbox -|- tint', (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b -|- t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tstzspan #>> tint', (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t #>> t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tbox #>> tint', (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b #>> t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tstzspan <<# tint', (SELECT COUNT(*) FROM tbl_tint_span t2, tbl_tint_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('tbox <<# tint', (SELECT COUNT(*) FROM tbl_tint_box t2, tbl_tint_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tint_idx(op, no_idx) VALUES ('|=| intspan', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tint_vspan t2, LATERAL (SELECT t1.temp |=| t2.v AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.v LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tint_idx(op, no_idx) VALUES ('|=| tbox', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tint_idx(op, no_idx) VALUES ('|=| tint', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
-- With no index a plan cannot probe one, whatever the planner settings
SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_box t2 WHERE t1.temp << t2.b') AS no_index_probe;
 no_index_probe 
----------------
 f
(1 row)

RESET enable_seqscan;
-------------------------------------------------------------------------------
CREATE INDEX tbl_tint_idx_rtree ON tbl_tint_idx USING gist(temp);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_vspan t2 WHERE t1.temp << t2.v)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_vspan t2 WHERE t1.temp << t2.v')
WHERE op = '<< intspan';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_box t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< tbox';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< tbox x';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< tint';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_vspan t2 WHERE t1.temp &< t2.v)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_vspan t2 WHERE t1.temp &< t2.v')
WHERE op = '&< intspan';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< tbox';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< tbox x';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_val t2 WHERE t1.temp &< t2.temp)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_val t2 WHERE t1.temp &< t2.temp')
WHERE op = '&< tint';
UPDATE test_tint_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tint_idx t1, tbl_tint_span t2 WHERE t1.temp && t2.t)::text,
