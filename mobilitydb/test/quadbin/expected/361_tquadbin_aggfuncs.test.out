WITH Temp(temp) AS (
  SELECT tquadbin '[480fffffffffffff@2001-01-01, 480fffffffffffff@2001-01-03]' UNION
  SELECT tquadbin '[48427fffffffffff@2001-01-02, 48427fffffffffff@2001-01-04]' )
SELECT tCount(Temp) FROM Temp;
