CREATE FUNCTION test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
CREATE FUNCTION
DROP TABLE IF EXISTS tbl_quadbinset_idx;
NOTICE:  table "tbl_quadbinset_idx" does not exist, skipping
DROP TABLE
CREATE TABLE tbl_quadbinset_idx AS
WITH src AS (
SELECT k, s FROM tbl_quadbinset)
SELECT k, s FROM src
UNION ALL
SELECT t1.k + 100000, t1.s + t2.s FROM src t1, src t2 WHERE t2.k = t1.k + 1;
SELECT 199
ANALYZE tbl_quadbinset_idx;
ANALYZE
DROP TABLE IF EXISTS test_quadbinset_idx;
NOTICE:  table "test_quadbinset_idx" does not exist, skipping
DROP TABLE
CREATE TABLE test_quadbinset_idx(op text, no_idx text, rtree_idx text, quadtree_idx text,
  kdtree_idx text, rtree_probe boolean, quadtree_probe boolean,
  kdtree_probe boolean);
CREATE TABLE
INSERT INTO test_quadbinset_idx(op, no_idx) VALUES ('&&', (SELECT COUNT(*) FROM tbl_quadbinset_idx t1, tbl_quadbinset_idx t2 WHERE t1.s && t2.s)::text);
INSERT 0 1
INSERT INTO test_quadbinset_idx(op, no_idx) VALUES ('=', (SELECT COUNT(*) FROM tbl_quadbinset_idx t1, tbl_quadbinset_idx t2 WHERE t1.s = t2.s)::text);
INSERT 0 1
INSERT INTO test_quadbinset_idx(op, no_idx) VALUES ('@> set', (SELECT COUNT(*) FROM tbl_quadbinset_idx t1, tbl_quadbinset_idx t2 WHERE t1.s @> t2.s)::text);
INSERT 0 1
INSERT INTO test_quadbinset_idx(op, no_idx) VALUES ('<@', (SELECT COUNT(*) FROM tbl_quadbinset_idx t1, tbl_quadbinset_idx t2 WHERE t1.s <@ t2.s)::text);
INSERT 0 1
INSERT INTO test_quadbinset_idx(op, no_idx) VALUES ('@> value', (SELECT COUNT(*) FROM tbl_quadbinset_idx t1, (SELECT startValue(s) AS v FROM tbl_quadbinset_idx) t2 WHERE t1.s @> t2.v)::text);
INSERT 0 1
