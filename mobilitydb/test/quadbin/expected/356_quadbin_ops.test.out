SELECT numValues(gridDisk(cells, 1)),
  gridDisk(cells, 1) = (SELECT setUnion(d)
    FROM unnest(cells) AS c, unnest(gridDisk(c, 1)) AS d),
  gridDisk(cells, 1) = gridDisk(quadbin '48a6227affffffff', 2),
  gridDisk(cells, 0) = cells
FROM s;
