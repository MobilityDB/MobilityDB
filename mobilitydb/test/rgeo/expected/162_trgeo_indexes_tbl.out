CREATE TABLE tbl_stbox_trgeometry AS
SELECT k, temp::stbox AS b FROM tbl_trgeometry2d WHERE temp IS NOT NULL;
SELECT 100
CREATE TABLE tbl_trgeometry_q AS
SELECT temp AS q FROM tbl_trgeometry2d WHERE temp IS NOT NULL ORDER BY k LIMIT 3;
SELECT 3
CREATE FUNCTION stbox_trgeometry_answers() RETURNS text AS $$
  SELECT string_agg(coalesce(c::text, 'null'), ',' ORDER BY o) FROM (
    SELECT 1, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b << q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 2, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &< q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 3, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b && q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 4, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 5, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b >> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 6, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b ~= q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 7, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b @> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 8, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b <@ q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 9, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &<| q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 10, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b <<| q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 11, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b |>> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 12, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b |&> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 13, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b -|- q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 14, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &<# q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 15, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b <<# q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 16, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b #>> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 17, (SELECT count(*) FROM tbl_stbox_trgeometry WHERE b #&> q) FROM tbl_trgeometry_q
    UNION ALL
    SELECT 18, (SELECT sum(k) FROM (SELECT k FROM tbl_stbox_trgeometry
      ORDER BY b |=| q, k LIMIT 5) s) FROM tbl_trgeometry_q) t(o, c);
$$ LANGUAGE SQL;
CREATE FUNCTION
CREATE FUNCTION stbox_trgeometry_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
CREATE FUNCTION
CREATE FUNCTION stbox_trgeometry_indexed() RETURNS text AS $$
  SELECT string_agg(CASE WHEN stbox_trgeometry_probes_index(query) THEN 't' ELSE 'f' END, '' ORDER BY o)
  FROM (VALUES
    (1, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b << (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (2, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &< (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (3, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b && (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (4, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (5, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b >> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (6, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b ~= (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (7, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b @> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (8, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b <@ (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (9, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &<| (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (10, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b <<| (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (11, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b |>> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (12, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b |&> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (13, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b -|- (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (14, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b &<# (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (15, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b <<# (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (16, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b #>> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (17, 'SELECT count(*) FROM tbl_stbox_trgeometry WHERE b #&> (SELECT q FROM tbl_trgeometry_q LIMIT 1)'),
    (18, 'SELECT k FROM tbl_stbox_trgeometry ORDER BY b |=| (SELECT q FROM tbl_trgeometry_q LIMIT 1) LIMIT 5')) t(o, query);
$$ LANGUAGE SQL;
CREATE FUNCTION
CREATE TABLE tbl_stbox_trgeometry_seq AS SELECT stbox_trgeometry_answers() AS a;
