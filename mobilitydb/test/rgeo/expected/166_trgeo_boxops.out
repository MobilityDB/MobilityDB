            1
(1 row)

SELECT array_length(mergeQuerySpans(trgeometry 'Polygon((0 0,1 0,1 1,0 1,0 0));[Pose(Point(0 0),0)@2001-01-01, Pose(Point(5 0),0)@2001-01-02, Pose(Point(10 0),0)@2001-01-03]', tstzspan '[2001-01-01, 2001-01-01 06:00]'), 1);
