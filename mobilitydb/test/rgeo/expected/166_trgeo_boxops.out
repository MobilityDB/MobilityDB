            1
(1 row)

-- A square turning a quarter turn about the origin: at the middle of the
-- segment its corner (2 2) lies at (0 2.83), so the box of the segment holds
-- the geometry at every instant of it, not only at its ends
WITH t(temp) AS (SELECT trgeometry 'Polygon((1 1,2 1,2 2,1 2,1 1));[Pose(Point(0 0),0)@2001-01-01, Pose(Point(0 0),1.5707963)@2001-01-02]')
SELECT (stboxes(temp))[1] @> stbox(valueAtTimestamp(temp, '2001-01-01 12:00')),
  (splitNStboxes(temp, 1))[1] @> stbox(valueAtTimestamp(temp, '2001-01-01 12:00')),
  (splitEachNStboxes(temp, 1))[1] @> stbox(valueAtTimestamp(temp, '2001-01-01 12:00'))
FROM t;
 ?column? | ?column? | ?column? 
----------+----------+----------
 t        | t        | t
(1 row)

WITH t(temp) AS (SELECT trgeometry 'Polygon((1 1,2 1,2 2,1 2,1 1));[Pose(Point(0 0),0)@2001-01-01, Pose(Point(0 0),1.5707963)@2001-01-02]')
SELECT (stboxes(temp))[1] @> stbox(valueAtTimestamp(temp, '2001-01-01 12:00')),
  (mergeNStboxes(temp, 1))[1] @> stbox(valueAtTimestamp(temp, '2001-01-01 12:00')),
  (mergeEachNStboxes(temp, 1))[1] @> stbox(valueAtTimestamp(temp, '2001-01-01 12:00'))
FROM t;
 ?column? | ?column? | ?column? 
----------+----------+----------
 t        | t        | t
(1 row)

-- A square moving without turning only translates, so the box of the segment
-- is the box of the square at its two ends
SELECT stbox(trgeometry 'Polygon((0 0,1 0,1 1,0 1,0 0));[Pose(Point(0 0), 0.0)@2001-01-01, Pose(Point(10 0), 0.0)@2001-01-02]');
                                         stbox                                         
---------------------------------------------------------------------------------------
 STBOX XT(((0,0),(11,1)),[Mon Jan 01 00:00:00 2001 PST, Tue Jan 02 00:00:00 2001 PST])
(1 row)

-- The box of the first and of the last slice of a sequence with exclusive
-- bounds leaves its bounds out, as the box of the sequence does, so every
-- box of a split lies in the box of the value
WITH t(temp) AS (SELECT trgeometry 'Polygon((0 0,1 0,0 1,0 0));(Pose(Point(1 1),0.5)@2001-01-01, Pose(Point(2 2),0.6)@2001-01-02, Pose(Point(3 3),0.7)@2001-01-03)')
SELECT splitNStboxes(temp, 2), splitEachNStboxes(temp, 1) FROM t;
                                      splitnstboxes                                       |                                    spliteachnstboxes                                     
------------------------------------------------------------------------------------------+------------------------------------------------------------------------------------------
 {"STBOX XT(((0,0),(4,4)),(Mon Jan 01 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST))"} | {"STBOX XT(((0,0),(4,4)),(Mon Jan 01 00:00:00 2001 PST, Wed Jan 03 00:00:00 2001 PST))"}
(1 row)

WITH t(temp) AS (SELECT trgeometry 'Polygon((0 0,1 0,0 1,0 0));(Pose(Point(1 1),0.5)@2001-01-01, Pose(Point(2 2),0.6)@2001-01-02, Pose(Point(3 3),0.7)@2001-01-03)')
SELECT bool_and(b <@ temp::stbox)
FROM t, unnest(splitNStboxes(temp, 2) || splitEachNStboxes(temp, 1)) b;
 bool_and 
----------
 t
(1 row)

