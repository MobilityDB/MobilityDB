  1.0, -1.0, 0.0, 0.0, 3857), '8BUI'::text, 1), '16BUI'::text, 2) AS r)
SELECT asHexWKB(addBand(r, r)) = asHexWKB(ST_AddBand(r, r)),
  asHexWKB(addBand(r, r, 2, 1)) = asHexWKB(ST_AddBand(r, r, 2, 1)),
  numBands(addBand(r, r, 2, 3))
