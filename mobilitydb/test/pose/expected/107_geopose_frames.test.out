SELECT count(*) AS meos_frames_absent_from_the_table FROM (
  SELECT frame_id, authority, code, name, srid, is_geographic
  FROM geoPoseFrames()
  EXCEPT
  SELECT frame_id, authority, code, name, srid, is_geographic
  FROM geopose_frames) d;
