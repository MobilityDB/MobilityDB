SELECT geoPoseFrameSRID(3) IS NULL AS ltp_srid_null,
       geoPoseFrameSRID(4) IS NULL AS body_srid_null;
 ltp_srid_null | body_srid_null 
---------------+----------------
 t             | t
(1 row)

SELECT frame_id, geoPoseFrameSRID(frame_id), geoPoseFrameName(frame_id),
  geoPoseFrameIsGeographic(frame_id)
FROM geoPoseFrames() ORDER BY frame_id;
 frame_id | geoposeframesrid |                  geoposeframename                  | geoposeframeisgeographic 
----------+------------------+----------------------------------------------------+--------------------------
        1 |             4326 | WGS-84 geographic (lat/lon/h)                      | t
        2 |             4978 | WGS-84 ECEF (Earth-Centred Earth-Fixed)            | f
        3 |                  | Local Tangent Plane (East-North-Up)                | f
        4 |                  | Right-handed body axes (default inner frame)       | f
        5 |                  | GeoPose outer frame of a Composite Sequence Series | f
        6 |                  | GeoPose inner frame of a Composite Sequence Series | f
        7 |                  | GeoPose outer frame of a Chain                     | f
        8 |                  | GeoPose inner frame of a Chain                     | f
(8 rows)

SELECT count(*) AS accessors_disagreeing_with_the_registry
FROM geoPoseFrames() f
WHERE geoPoseFrameSRID(f.frame_id) IS DISTINCT FROM f.srid
   OR geoPoseFrameName(f.frame_id) IS DISTINCT FROM f.name
   OR geoPoseFrameIsGeographic(f.frame_id) IS DISTINCT FROM f.is_geographic;
 accessors_disagreeing_with_the_registry 
-----------------------------------------
                                       0
(1 row)

