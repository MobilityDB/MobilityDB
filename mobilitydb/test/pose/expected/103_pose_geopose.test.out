SELECT d->'innerFrameSeries'->0->>'authority', d->'innerFrameSeries'->0->>'id',
  split_part(d->'innerFrameSeries'->0->>'parameters', '&', 1)
FROM j;
   ?column?   |    ?column?     |      split_part       
