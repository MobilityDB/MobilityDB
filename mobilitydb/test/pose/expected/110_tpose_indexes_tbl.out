INSERT INTO test_tpose_idx(op, no_idx) VALUES ('tstzspan <@ tpose', (SELECT COUNT(*) FROM tbl_tpose2d_span t2, tbl_tpose2d_idx t1 WHERE t2.t <@ t1.temp)::text);
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('stbox <@ tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b <@ t1.temp)::text);
