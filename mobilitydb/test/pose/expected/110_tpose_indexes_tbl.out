INSERT INTO test_tpose_idx(op, no_idx) VALUES ('stbox #>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b #>> t1.temp)::text);
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('tstzspan <<# tpose', (SELECT COUNT(*) FROM tbl_tpose2d_span t2, tbl_tpose2d_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('stbox <<# tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('|=| stbox', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tpose2d_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tpose2d_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('|=| tpose', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tpose2d_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tpose2d_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(s.d::text, ',' ORDER BY s.d) FROM tbl_tpose2d_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tpose2d_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
-- With no index a plan cannot probe one, whatever the planner settings
SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp << t2.b') AS no_index_probe;
 no_index_probe 
----------------
 f
(1 row)

RESET enable_seqscan;
-------------------------------------------------------------------------------
CREATE INDEX tbl_tpose2d_idx_rtree ON tbl_tpose2d_idx USING gist(temp);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tpose_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp << t2.b)::text,
  rtree_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_tpose_idx SET rtree_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp << t2.b)::text,
