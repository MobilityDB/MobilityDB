-- Every row carries the same value, so a split of the quad-tree finds keys that
-- are all equal
CREATE TEMP TABLE tbl_tpose_allthesame AS
SELECT k, tpose(pose 'SRID=3812;Pose(Point(5 5), 0.5)', t) AS temp
FROM tbl_tstzspan_big;
CREATE INDEX tbl_tpose_allthesame_quadtree ON tbl_tpose_allthesame USING spgist(temp);
SELECT COUNT(*) AS rows_scan FROM tbl_tpose_allthesame WHERE temp && stbox 'SRID=3812;STBOX X((5,5),(5,5))';
 rows_scan 
-----------
     10100
(1 row)

SET enable_seqscan = off;
SELECT pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose_allthesame WHERE temp && stbox ''SRID=3812;STBOX X((5,5),(5,5))''') AS probe;
