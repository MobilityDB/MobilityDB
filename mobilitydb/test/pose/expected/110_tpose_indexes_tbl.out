INSERT INTO test_tpose_idx(op, no_idx) VALUES ('-|- tstzspan', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_span t2 WHERE t1.temp -|- t2.t)::text);
INSERT INTO test_tpose_idx(op, no_idx) VALUES ('-|- stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp -|- t2.b)::text);
