WITH t AS (
  SELECT th3index(
    tgeompoint 'SRID=4326;[POINT(4.35 50.85)@2024-01-01,
                 POINT(4.40 50.90)@2024-01-02]', 7) AS th3idx
)
-- Set covering a polygon that contains both endpoints → prefilter true
