WITH rast AS (
  SELECT ST_AddBand(
    ST_MakeEmptyRaster(3, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 4326),
    '32BF'::text, 1.0::float8, NULL::float8) AS r
)
SELECT r / (r - r) FROM rast;
