  (SELECT count(*) FROM rast, ST_DumpAsPolygons(r, 1, false)) AS postgis_regions,
  (SELECT count(*) FROM empty, dumpAsPolygons(r)) AS empty_regions,
  (SELECT count(*) FROM empty, ST_DumpAsPolygons(r)) AS postgis_empty_regions;
