CREATE TABLE tbl_union_many AS
SELECT i, ST_AddBand(ST_MakeEmptyRaster(2, 2, (i % 10)::float8,
    (i / 10)::float8, 1.0, -1.0, 0.0, 0.0, 3857), '32BF'::text,
    (i % 7)::float8, -9999.0::float8) AS r
FROM generate_series(1, 200) i;
