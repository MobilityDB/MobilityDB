INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('stbox >> ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_box t2, tbl_ts2cell_idx t1 WHERE t2.b >> t1.temp)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('tstzspan && ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_span t2, tbl_ts2cell_idx t1 WHERE t2.t && t1.temp)::text);
