-------------------------------------------------------------------------------
CREATE INDEX tbl_ts2cell_idx_rtree_equi ON tbl_ts2cell_idx
  USING mgist(temp ts2cell_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_ts2cell_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_ts2cell_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox x';
UPDATE test_ts2cell_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< ts2cell';
UPDATE test_ts2cell_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox';
UPDATE test_ts2cell_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox x';
UPDATE test_ts2cell_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp &< t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp &< t2.temp')
