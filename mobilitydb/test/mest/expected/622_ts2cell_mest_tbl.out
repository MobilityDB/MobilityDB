INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('-|- tstzspan', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_span t2 WHERE t1.temp -|- t2.t)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('-|- stbox', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp -|- t2.b)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('-|- stbox x', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_xbox t2 WHERE t1.temp -|- t2.b)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('-|- ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp -|- t2.temp)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('&<# tstzspan', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_span t2 WHERE t1.temp &<# t2.t)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('&<# stbox', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp &<# t2.b)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('&<# ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp &<# t2.temp)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('<<# tstzspan', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_span t2 WHERE t1.temp <<# t2.t)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('<<# stbox', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp <<# t2.b)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('<<# ts2cell', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_val t2 WHERE t1.temp <<# t2.temp)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('#>> tstzspan', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_span t2 WHERE t1.temp #>> t2.t)::text);
INSERT INTO test_ts2cell_mest(op, no_idx) VALUES ('#>> stbox', (SELECT COUNT(*) FROM tbl_ts2cell_idx t1, tbl_ts2cell_box t2 WHERE t1.temp #>> t2.b)::text);
