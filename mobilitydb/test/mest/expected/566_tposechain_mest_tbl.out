INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('<<| stbox', (SELECT COUNT(*) FROM tbl_tposechain2d_idx t1, tbl_tposechain2d_box t2 WHERE t1.temp <<| t2.b)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('<<| stbox x', (SELECT COUNT(*) FROM tbl_tposechain2d_idx t1, tbl_tposechain2d_xbox t2 WHERE t1.temp <<| t2.b)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('<<| tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_idx t1, tbl_tposechain2d_val t2 WHERE t1.temp <<| t2.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('|>> stbox', (SELECT COUNT(*) FROM tbl_tposechain2d_idx t1, tbl_tposechain2d_box t2 WHERE t1.temp |>> t2.b)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('|>> stbox x', (SELECT COUNT(*) FROM tbl_tposechain2d_idx t1, tbl_tposechain2d_xbox t2 WHERE t1.temp |>> t2.b)::text);
