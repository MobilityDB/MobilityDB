INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('tstzspan -|- tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_span t2, tbl_tposechain2d_idx t1 WHERE t2.t -|- t1.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('stbox -|- tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_box t2, tbl_tposechain2d_idx t1 WHERE t2.b -|- t1.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('tstzspan #>> tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_span t2, tbl_tposechain2d_idx t1 WHERE t2.t #>> t1.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('stbox #>> tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_box t2, tbl_tposechain2d_idx t1 WHERE t2.b #>> t1.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('tstzspan <<# tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_span t2, tbl_tposechain2d_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('stbox <<# tposechain', (SELECT COUNT(*) FROM tbl_tposechain2d_box t2, tbl_tposechain2d_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('|=| stbox', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tposechain2d_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tposechain2d_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('|=| tposechain', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tposechain2d_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tposechain2d_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tposechain_mest(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tposechain2d_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tposechain2d_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
-------------------------------------------------------------------------------
CREATE INDEX tbl_tposechain2d_idx_rtree_equi ON tbl_tposechain2d_idx
  USING mgist(temp tposechain_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
