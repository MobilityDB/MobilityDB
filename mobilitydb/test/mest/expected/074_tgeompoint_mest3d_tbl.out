INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('&< tgeompoint', (SELECT COUNT(*) FROM tbl_tgeompoint3d_idx t1, tbl_tgeompoint3d_val t2 WHERE t1.temp &< t2.temp)::text);
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('&& tstzspan', (SELECT COUNT(*) FROM tbl_tgeompoint3d_idx t1, tbl_tgeompoint3d_span t2 WHERE t1.temp && t2.t)::text);
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('&& stbox', (SELECT COUNT(*) FROM tbl_tgeompoint3d_idx t1, tbl_tgeompoint3d_box t2 WHERE t1.temp && t2.b)::text);
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('&& stbox x', (SELECT COUNT(*) FROM tbl_tgeompoint3d_idx t1, tbl_tgeompoint3d_xbox t2 WHERE t1.temp && t2.b)::text);
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('&& tgeompoint', (SELECT COUNT(*) FROM tbl_tgeompoint3d_idx t1, tbl_tgeompoint3d_val t2 WHERE t1.temp && t2.temp)::text);
