INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('&> stbox x', (SELECT COUNT(*) FROM tbl_tgeompoint3d_idx t1, tbl_tgeompoint3d_xbox t2 WHERE t1.temp &> t2.b)::text);
