-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a ttext,
-- keyed by the tstzspanes of the pieces of the value, one per split (equi, seg,
-- bin). Under each index the ever and always overlaps, with each right argument
-- they declare, answer the rows a sequential scan gives, from a plan that probes
-- the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_ttext_idx;
NOTICE:  table "tbl_ttext_idx" does not exist, skipping
CREATE TEMP TABLE tbl_ttext_idx AS
WITH base(k, temp) AS (
  SELECT k, temp FROM tbl_ttext_big
  UNION ALL
  SELECT k + 10100, temp FROM tbl_ttext_inst
  UNION ALL
  SELECT k + 10200, temp FROM tbl_ttext_discseq
  UNION ALL
  SELECT k + 10300, temp FROM tbl_ttext_contseq
  UNION ALL
  SELECT k + 10400, temp FROM tbl_ttext_seqset )
SELECT k + n * 10500 AS k, shiftTime(temp, n * interval '1 week') AS temp
FROM base, generate_series(0, 0) AS n;
ANALYZE tbl_ttext_idx;
-- The values and periods the operators are given. Those of the fixture are
-- random, so they meet few values exactly: the others come from the rows of the
-- table, so that every operator has rows to answer.
DROP TABLE IF EXISTS tbl_ttext_src;
NOTICE:  table "tbl_ttext_src" does not exist, skipping
CREATE TEMP TABLE tbl_ttext_src AS
SELECT k, temp, temp::tstzspan AS t
FROM tbl_ttext_idx WHERE k % 1000 = 0 AND temp IS NOT NULL;
-- A value of the fixture, a value of the table, and one whose period ends where
-- that of the value starts
DROP TABLE IF EXISTS tbl_ttext_val;
NOTICE:  table "tbl_ttext_val" does not exist, skipping
CREATE TEMP TABLE tbl_ttext_val AS
SELECT temp, false AS knn FROM tbl_ttext WHERE k % 20 = 0
UNION ALL
SELECT temp, true FROM tbl_ttext_src
UNION ALL
SELECT shiftTime(temp, lower(t) - upper(t)), false FROM tbl_ttext_src;
ANALYZE tbl_ttext_val;
-- A period of the fixture, the period of a value, one around it, one inside it,
-- and one that meets it
DROP TABLE IF EXISTS tbl_ttext_span;
NOTICE:  table "tbl_ttext_span" does not exist, skipping
CREATE TEMP TABLE tbl_ttext_span AS
SELECT t FROM tbl_tstzspan WHERE k % 20 = 0
UNION ALL
SELECT t FROM tbl_ttext_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) - interval '1 day', upper(t) + interval '1 day'))
FROM tbl_ttext_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2))
FROM tbl_ttext_src
UNION ALL
SELECT tstzspan(format('[%s, %s%s', lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END))
FROM tbl_ttext_src;
ANALYZE tbl_ttext_span;
DROP TABLE IF EXISTS test_ttext_mest;
NOTICE:  table "test_ttext_mest" does not exist, skipping
CREATE TEMP TABLE test_ttext_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_bin_idx text, rtree_bin_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_bin_idx text, quadtree_bin_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_bin_idx text, kdtree_bin_probe boolean);
INSERT INTO test_ttext_mest(op, no_idx) VALUES ('?&& tstzspan', (SELECT COUNT(*) FROM tbl_ttext_idx t1, tbl_ttext_span t2 WHERE t1.temp ?&& t2.t)::text);
INSERT INTO test_ttext_mest(op, no_idx) VALUES ('%&& tstzspan', (SELECT COUNT(*) FROM tbl_ttext_idx t1, tbl_ttext_span t2 WHERE t1.temp %&& t2.t)::text);
-------------------------------------------------------------------------------
CREATE INDEX tbl_ttext_idx_rtree_equi ON tbl_ttext_idx
  USING mgist(temp ttext_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_ttext_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ttext_idx t1, tbl_ttext_span t2 WHERE t1.temp ?&& t2.t)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ttext_idx t1, tbl_ttext_span t2 WHERE t1.temp ?&& t2.t')
WHERE op = '?&& tstzspan';
UPDATE test_ttext_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_ttext_idx t1, tbl_ttext_span t2 WHERE t1.temp %&& t2.t)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_ttext_idx t1, tbl_ttext_span t2 WHERE t1.temp %&& t2.t')
WHERE op = '%&& tstzspan';
RESET enable_seqscan;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_sort;
DROP INDEX tbl_ttext_idx_rtree_equi;
-------------------------------------------------------------------------------
