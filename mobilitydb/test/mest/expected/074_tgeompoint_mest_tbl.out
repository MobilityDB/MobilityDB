UPDATE test_tgeompoint_mest SET kdtree_adapt_idx = (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn),
  kdtree_adapt_probe = pg_temp.test_probes_index('SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, '','' ORDER BY s.d) FROM tbl_tgeompoint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| stbox';
UPDATE test_tgeompoint_mest SET kdtree_adapt_idx = (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn),
  kdtree_adapt_probe = pg_temp.test_probes_index('SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, '','' ORDER BY s.d) FROM tbl_tgeompoint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| tgeompoint';
UPDATE test_tgeompoint_mest SET kdtree_adapt_idx = (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn),
  kdtree_adapt_probe = pg_temp.test_probes_index('SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, '','' ORDER BY s.d) FROM tbl_tgeompoint_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn')
WHERE op = '|=| geometry';
RESET enable_seqscan;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_sort;
DROP INDEX tbl_tgeompoint_idx_kdtree_adapt;
