INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('tstzspan <<# tgeompoint', (SELECT COUNT(*) FROM tbl_tgeompoint_span t2, tbl_tgeompoint_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('stbox <<# tgeompoint', (SELECT COUNT(*) FROM tbl_tgeompoint_box t2, tbl_tgeompoint_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('|=| stbox', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('|=| tgeompoint', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeompoint_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeompoint_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
