CREATE INDEX tbl_tgeompoint_idx_rtree_adapt ON tbl_tgeompoint_idx
  USING mgist(temp tgeompoint_mrtree_adaptsplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
