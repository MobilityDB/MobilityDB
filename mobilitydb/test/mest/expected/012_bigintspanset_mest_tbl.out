-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a
-- bigintspanset, keyed by the spans of its components, one per split (equi, seg,
-- merge, adapt). Under each index every operator the class holds, with each right
-- argument it declares, answers the rows a sequential scan gives, from a plan that
-- probes the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_bigintspanset_idx;
NOTICE:  table "tbl_bigintspanset_idx" does not exist, skipping
CREATE TEMP TABLE tbl_bigintspanset_idx AS TABLE tbl_bigintspanset;
ANALYZE tbl_bigintspanset_idx;
DROP TABLE IF EXISTS test_bigintspanset_mest;
NOTICE:  table "test_bigintspanset_mest" does not exist, skipping
CREATE TEMP TABLE test_bigintspanset_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_merge_idx text, rtree_merge_probe boolean,
  rtree_adapt_idx text, rtree_adapt_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_merge_idx text, quadtree_merge_probe boolean,
  quadtree_adapt_idx text, quadtree_adapt_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_merge_idx text, kdtree_merge_probe boolean,
  kdtree_adapt_idx text, kdtree_adapt_probe boolean);
INSERT INTO test_bigintspanset_mest(op, no_idx) VALUES ('<< bigint', (SELECT COUNT(*) FROM tbl_bigintspanset_idx t1, tbl_bigint t2 WHERE t1.b << t2.b)::text);
INSERT INTO test_bigintspanset_mest(op, no_idx) VALUES ('<< bigintspan', (SELECT COUNT(*) FROM tbl_bigintspanset_idx t1, tbl_bigintspan t2 WHERE t1.b << t2.b)::text);
INSERT INTO test_bigintspanset_mest(op, no_idx) VALUES ('<< bigintspanset', (SELECT COUNT(*) FROM tbl_bigintspanset_idx t1, tbl_bigintspanset t2 WHERE t1.b << t2.b)::text);
INSERT INTO test_bigintspanset_mest(op, no_idx) VALUES ('&< bigint', (SELECT COUNT(*) FROM tbl_bigintspanset_idx t1, tbl_bigint t2 WHERE t1.b &< t2.b)::text);
INSERT INTO test_bigintspanset_mest(op, no_idx) VALUES ('&< bigintspan', (SELECT COUNT(*) FROM tbl_bigintspanset_idx t1, tbl_bigintspan t2 WHERE t1.b &< t2.b)::text);
