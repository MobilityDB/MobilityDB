  rtree_equi_probe = pg_temp.test_probes_index('SELECT string_agg(s.d, '';'' ORDER BY t2.k) FROM (SELECT * FROM tbl_dateset WHERE d IS NOT NULL ORDER BY k LIMIT 5) t2, LATERAL (SELECT string_agg((t1.d <-> t2.d)::text, '','' ORDER BY t1.d <-> t2.d) AS d FROM (SELECT t1.d FROM tbl_dateset_idx t1 ORDER BY t1.d <-> t2.d LIMIT 3) t1) s')
WHERE op = '<-> dateset';
