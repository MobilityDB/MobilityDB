-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a
-- dateset, keyed by the spans of its elements, one per split (equi, seg, merge,
-- adapt). Under each index every operator the class holds, with each right
-- argument it declares, answers the rows a sequential scan gives, from a plan that
-- probes the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_dateset_idx;
NOTICE:  table "tbl_dateset_idx" does not exist, skipping
CREATE TEMP TABLE tbl_dateset_idx AS TABLE tbl_dateset;
ANALYZE tbl_dateset_idx;
DROP TABLE IF EXISTS test_dateset_mest;
NOTICE:  table "test_dateset_mest" does not exist, skipping
CREATE TEMP TABLE test_dateset_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_merge_idx text, rtree_merge_probe boolean,
  rtree_adapt_idx text, rtree_adapt_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_merge_idx text, quadtree_merge_probe boolean,
  quadtree_adapt_idx text, quadtree_adapt_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_merge_idx text, kdtree_merge_probe boolean,
  kdtree_adapt_idx text, kdtree_adapt_probe boolean);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('&& dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d && t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('@> date', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d @> t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('@> dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d @> t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('<@ dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d <@ t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('= dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d = t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('<-> date', (SELECT string_agg(s.d, ';' ORDER BY t2.k) FROM (SELECT * FROM tbl_date WHERE d IS NOT NULL ORDER BY k LIMIT 5) t2, LATERAL (SELECT string_agg((t1.d <-> t2.d)::text, ',' ORDER BY t1.d <-> t2.d) AS d FROM (SELECT t1.d FROM tbl_dateset_idx t1 ORDER BY t1.d <-> t2.d LIMIT 3) t1) s)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('<-> dateset', (SELECT string_agg(s.d, ';' ORDER BY t2.k) FROM (SELECT * FROM tbl_dateset WHERE d IS NOT NULL ORDER BY k LIMIT 5) t2, LATERAL (SELECT string_agg((t1.d <-> t2.d)::text, ',' ORDER BY t1.d <-> t2.d) AS d FROM (SELECT t1.d FROM tbl_dateset_idx t1 ORDER BY t1.d <-> t2.d LIMIT 3) t1) s)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('&<# date', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d &<# t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('&<# dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d &<# t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('<<# date', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d <<# t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('<<# dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d <<# t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('#>> date', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d #>> t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('#>> dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d #>> t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('#&> date', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d #&> t2.d)::text);
INSERT INTO test_dateset_mest(op, no_idx) VALUES ('#&> dateset', (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d #&> t2.d)::text);
-------------------------------------------------------------------------------
CREATE INDEX tbl_dateset_idx_rtree_equi ON tbl_dateset_idx
  USING mgist(d dateset_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_dateset_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d && t2.d)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_dateset t2 WHERE t1.d && t2.d')
WHERE op = '&& dateset';
UPDATE test_dateset_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d @> t2.d)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_dateset_idx t1, tbl_date t2 WHERE t1.d @> t2.d')
WHERE op = '@> date';
