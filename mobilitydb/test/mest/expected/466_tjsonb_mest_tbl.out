WHERE op = 'tstzspan #>> tjsonb';
UPDATE test_tjsonb_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tjsonb_span t2, tbl_tjsonb_idx t1 WHERE t2.t <<# t1.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tjsonb_span t2, tbl_tjsonb_idx t1 WHERE t2.t <<# t1.temp')
WHERE op = 'tstzspan <<# tjsonb';
RESET enable_seqscan;
