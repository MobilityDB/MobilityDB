INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('&& stbox', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp && t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('&& stbox x', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp && t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('&& tgeometry', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp && t2.temp)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('&> stbox', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp &> t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('&> stbox x', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp &> t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('&> tgeometry', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp &> t2.temp)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('>> stbox', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp >> t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('>> stbox x', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp >> t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('>> tgeometry', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp >> t2.temp)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('@> tstzspan', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_span t2 WHERE t1.temp @> t2.t)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('@> stbox', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp @> t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('@> stbox x', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp @> t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('@> tgeometry', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp @> t2.temp)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('<@ tstzspan', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_span t2 WHERE t1.temp <@ t2.t)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('<@ stbox', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp <@ t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('<@ stbox x', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp <@ t2.b)::text);
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('<@ tgeometry', (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp <@ t2.temp)::text);
