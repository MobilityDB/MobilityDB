INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('tstzspan #>> tgeometry', (SELECT COUNT(*) FROM tbl_tgeometry_span t2, tbl_tgeometry_idx t1 WHERE t2.t #>> t1.temp)::text);
