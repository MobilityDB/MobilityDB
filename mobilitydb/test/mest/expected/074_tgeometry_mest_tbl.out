  no_idx IS DISTINCT FROM kdtree_adapt_idx OR NOT kdtree_adapt_probe
ORDER BY op;
 op | no_idx | rtree_equi_idx | rtree_equi_probe | rtree_seg_idx | rtree_seg_probe | rtree_merge_idx | rtree_merge_probe | rtree_linear_idx | rtree_linear_probe | rtree_adapt_idx | rtree_adapt_probe | quadtree_equi_idx | quadtree_equi_probe | quadtree_seg_idx | quadtree_seg_probe | quadtree_merge_idx | quadtree_merge_probe | quadtree_linear_idx | quadtree_linear_probe | quadtree_adapt_idx | quadtree_adapt_probe | kdtree_equi_idx | kdtree_equi_probe | kdtree_seg_idx | kdtree_seg_probe | kdtree_merge_idx | kdtree_merge_probe | kdtree_linear_idx | kdtree_linear_probe | kdtree_adapt_idx | kdtree_adapt_probe 
