INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('|=| stbox', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeometry_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tgeometry_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('|=| tgeometry', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeometry_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tgeometry_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tgeometry_mest(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tgeometry_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tgeometry_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
-------------------------------------------------------------------------------
CREATE INDEX tbl_tgeometry_idx_rtree_equi ON tbl_tgeometry_idx
  USING mgist(temp tgeometry_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tgeometry_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_tgeometry_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox x';
UPDATE test_tgeometry_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< tgeometry';
UPDATE test_tgeometry_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox';
UPDATE test_tgeometry_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox x';
UPDATE test_tgeometry_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tgeometry_idx t1, tbl_tgeometry_val t2 WHERE t1.temp &< t2.temp)::text,
