-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a
-- tstzspanset, keyed by the spans of its components, one per split (equi, seg,
-- merge, adapt). Under each index every operator the class holds, with each right
-- argument it declares, answers the rows a sequential scan gives, from a plan that
-- probes the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_tstzspanset_idx;
NOTICE:  table "tbl_tstzspanset_idx" does not exist, skipping
CREATE TEMP TABLE tbl_tstzspanset_idx AS TABLE tbl_tstzspanset;
ANALYZE tbl_tstzspanset_idx;
DROP TABLE IF EXISTS test_tstzspanset_mest;
NOTICE:  table "test_tstzspanset_mest" does not exist, skipping
CREATE TEMP TABLE test_tstzspanset_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_merge_idx text, rtree_merge_probe boolean,
  rtree_adapt_idx text, rtree_adapt_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_merge_idx text, quadtree_merge_probe boolean,
  quadtree_adapt_idx text, quadtree_adapt_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_merge_idx text, kdtree_merge_probe boolean,
  kdtree_adapt_idx text, kdtree_adapt_probe boolean);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('&& tstzspan', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspan t2 WHERE t1.t && t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('&& tstzspanset', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspanset t2 WHERE t1.t && t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('@> timestamptz', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_timestamptz t2 WHERE t1.t @> t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('@> tstzspan', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspan t2 WHERE t1.t @> t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('@> tstzspanset', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspanset t2 WHERE t1.t @> t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('<@ tstzspan', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspan t2 WHERE t1.t <@ t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('<@ tstzspanset', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspanset t2 WHERE t1.t <@ t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('-|- timestamptz', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_timestamptz t2 WHERE t1.t -|- t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('-|- tstzspan', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspan t2 WHERE t1.t -|- t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('-|- tstzspanset', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspanset t2 WHERE t1.t -|- t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('= tstzspanset', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspanset t2 WHERE t1.t = t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('<-> timestamptz', (SELECT string_agg(s.d, ';' ORDER BY t2.k) FROM (SELECT * FROM tbl_timestamptz WHERE t IS NOT NULL ORDER BY k LIMIT 5) t2, LATERAL (SELECT string_agg((t1.t <-> t2.t)::text, ',' ORDER BY t1.t <-> t2.t) AS d FROM (SELECT t1.t FROM tbl_tstzspanset_idx t1 ORDER BY t1.t <-> t2.t LIMIT 3) t1) s)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('<-> tstzspan', (SELECT string_agg(s.d, ';' ORDER BY t2.k) FROM (SELECT * FROM tbl_tstzspan WHERE t IS NOT NULL ORDER BY k LIMIT 5) t2, LATERAL (SELECT string_agg((t1.t <-> t2.t)::text, ',' ORDER BY t1.t <-> t2.t) AS d FROM (SELECT t1.t FROM tbl_tstzspanset_idx t1 ORDER BY t1.t <-> t2.t LIMIT 3) t1) s)::text);
