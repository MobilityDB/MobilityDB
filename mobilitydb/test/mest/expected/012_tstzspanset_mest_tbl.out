INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('#>> timestamptz', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_timestamptz t2 WHERE t1.t #>> t2.t)::text);
INSERT INTO test_tstzspanset_mest(op, no_idx) VALUES ('#>> tstzspan', (SELECT COUNT(*) FROM tbl_tstzspanset_idx t1, tbl_tstzspan t2 WHERE t1.t #>> t2.t)::text);
