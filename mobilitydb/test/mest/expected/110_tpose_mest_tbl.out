-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a tpose
-- in two dimensions, keyed by the stboxes of the pieces of the value, one per
-- split (equi, seg, merge, linear, adapt). Under each index the ever and always
-- overlaps, with each right argument they declare, answer the rows a sequential
-- scan gives, from a plan that probes the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_tpose2d_idx;
NOTICE:  table "tbl_tpose2d_idx" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_idx AS
WITH base(k, temp) AS (
  SELECT k, temp FROM tbl_tpose2d
  UNION ALL
  SELECT k + 100, temp FROM tbl_tpose2d_inst
  UNION ALL
  SELECT k + 200, temp FROM tbl_tpose2d_discseq
  UNION ALL
  SELECT k + 300, temp FROM tbl_tpose2d_contseq
  UNION ALL
  SELECT k + 400, temp FROM tbl_tpose2d_seqset )
SELECT k + n * 500 AS k, shiftTime(temp, n * interval '1 week') AS temp
FROM base, generate_series(0, 9) AS n;
ANALYZE tbl_tpose2d_idx;
-- The values, boxes and periods the operators are given. Those of the fixture
-- are random, so they meet few values exactly: the others come from the rows of
-- the table, so that every operator has rows to answer.
DROP TABLE IF EXISTS tbl_tpose2d_src;
NOTICE:  table "tbl_tpose2d_src" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_src AS
SELECT k, temp, temp::stbox AS b, temp::tstzspan AS t
FROM tbl_tpose2d_idx WHERE k % 470 = 0;
-- A value of the fixture, a value of the table, and one whose period ends where
-- that of the value starts. The search for the nearest values, whose distance
-- costs more than a box, is given the second alone.
DROP TABLE IF EXISTS tbl_tpose2d_val;
NOTICE:  table "tbl_tpose2d_val" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_val AS
SELECT temp, false AS knn FROM tbl_tpose2d WHERE k % 20 = 0
UNION ALL
SELECT temp, true FROM tbl_tpose2d_src
UNION ALL
SELECT shiftTime(temp, lower(t) - upper(t)), false FROM tbl_tpose2d_src;
ANALYZE tbl_tpose2d_val;
-- The box of a value of the fixture, the box of a value, one around it, one
-- inside it, and one whose period meets it
DROP TABLE IF EXISTS tbl_tpose2d_box;
NOTICE:  table "tbl_tpose2d_box" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_box AS
SELECT temp::stbox AS b, false AS knn FROM tbl_tpose2d WHERE k % 20 = 0
UNION ALL
SELECT b, true FROM tbl_tpose2d_src
UNION ALL
SELECT expandTime(expandSpace(b, 0.1), interval '1 day'), false FROM tbl_tpose2d_src
UNION ALL
SELECT stbox(format('SRID=3812;STBOX XT(((%s,%s),(%s,%s)),[%s,%s])',
    (xmin(b) + xmax(b)) / 2, (ymin(b) + ymax(b)) / 2, (xmin(b) + xmax(b)) / 2 + 0.000001, (ymin(b) + ymax(b)) / 2 + 0.000001,
    lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2)), false
FROM tbl_tpose2d_src
UNION ALL
SELECT stbox(format('SRID=3812;STBOX XT(((%s,%s),(%s,%s)),[%s,%s%s)',
    xmin(b), ymin(b), xmax(b), ymax(b), lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END)), false
FROM tbl_tpose2d_src;
ANALYZE tbl_tpose2d_box;
-- A box of space alone, which the operators on time refuse: one around a value,
-- one inside it, the space of a value, and one that meets it
DROP TABLE IF EXISTS tbl_tpose2d_xbox;
NOTICE:  table "tbl_tpose2d_xbox" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_xbox AS
SELECT stbox(format('SRID=3812;STBOX X((%s,%s),(%s,%s))',
    xmin(b) - 0.1, ymin(b) - 0.1, xmax(b) + 0.1, ymax(b) + 0.1)) AS b
FROM tbl_tpose2d_src
UNION ALL
SELECT stbox(format('SRID=3812;STBOX X((%s,%s),(%s,%s))',
    (xmin(b) + xmax(b)) / 2, (ymin(b) + ymax(b)) / 2, (xmin(b) + xmax(b)) / 2 + 0.000001, (ymin(b) + ymax(b)) / 2 + 0.000001)) AS b
FROM tbl_tpose2d_src
UNION ALL
SELECT stbox(format('SRID=3812;STBOX X((%s,%s),(%s,%s))',
    xmin(b), ymin(b), xmax(b), ymax(b))) AS b
FROM tbl_tpose2d_src
UNION ALL
SELECT stbox(format('SRID=3812;STBOX X((%s,%s),(%s,%s))',
    xmax(b), ymin(b), xmax(b) + 0.1, ymax(b))) AS b
FROM tbl_tpose2d_src;
ANALYZE tbl_tpose2d_xbox;
-- A period of the fixture, the period of a value, one around it, one inside it,
-- and one that meets it
DROP TABLE IF EXISTS tbl_tpose2d_span;
NOTICE:  table "tbl_tpose2d_span" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_span AS
SELECT t FROM tbl_tstzspan WHERE k % 20 = 0
UNION ALL
SELECT t FROM tbl_tpose2d_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) - interval '1 day', upper(t) + interval '1 day'))
FROM tbl_tpose2d_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2))
FROM tbl_tpose2d_src
UNION ALL
SELECT tstzspan(format('[%s, %s%s', lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END))
FROM tbl_tpose2d_src;
ANALYZE tbl_tpose2d_span;
-- A point at a corner of the box of a value
DROP TABLE IF EXISTS tbl_tpose2d_geo;
NOTICE:  table "tbl_tpose2d_geo" does not exist, skipping
CREATE TEMP TABLE tbl_tpose2d_geo AS
SELECT ST_SetSRID(ST_MakePoint(xmin(b), ymin(b)), 3812) AS g, true AS knn FROM tbl_tpose2d_src;
ANALYZE tbl_tpose2d_geo;
DROP TABLE IF EXISTS test_tpose_mest;
NOTICE:  table "test_tpose_mest" does not exist, skipping
CREATE TEMP TABLE test_tpose_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_merge_idx text, rtree_merge_probe boolean,
  rtree_linear_idx text, rtree_linear_probe boolean,
  rtree_adapt_idx text, rtree_adapt_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_merge_idx text, quadtree_merge_probe boolean,
  quadtree_linear_idx text, quadtree_linear_probe boolean,
  quadtree_adapt_idx text, quadtree_adapt_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_merge_idx text, kdtree_merge_probe boolean,
  kdtree_linear_idx text, kdtree_linear_probe boolean,
  kdtree_adapt_idx text, kdtree_adapt_probe boolean);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<< stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp << t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<< stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp << t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<< tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp << t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&< stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &< t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&< stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &< t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&< tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &< t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&> stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&> stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &> t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('>> stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp >> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('>> stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp >> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp >> t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<@ tstzspan', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_span t2 WHERE t1.temp <@ t2.t)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<@ stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp <@ t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<@ stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp <@ t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<@ tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp <@ t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<| stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &<| t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<| stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &<| t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<| tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &<| t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<<| stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp <<| t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<<| stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp <<| t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<<| tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp <<| t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|>> stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp |>> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|>> stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp |>> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp |>> t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|&> stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp |&> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|&> stbox x', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp |&> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|&> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp |&> t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<# tstzspan', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_span t2 WHERE t1.temp &<# t2.t)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<# stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &<# t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<# tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &<# t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<<# tstzspan', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_span t2 WHERE t1.temp <<# t2.t)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<<# stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp <<# t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('<<# tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp <<# t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('#>> tstzspan', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_span t2 WHERE t1.temp #>> t2.t)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('#>> stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp #>> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('#>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp #>> t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('#&> tstzspan', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_span t2 WHERE t1.temp #&> t2.t)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('#&> stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp #&> t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('#&> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp #&> t2.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('?&& stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp ?&& t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('%&& stbox', (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp %&& t2.b)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox >> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b >> t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox << tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b << t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('tstzspan @> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_span t2, tbl_tpose2d_idx t1 WHERE t2.t @> t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox @> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b @> t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox |>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b |>> t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox <<| tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b <<| t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('tstzspan #>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_span t2, tbl_tpose2d_idx t1 WHERE t2.t #>> t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox #>> tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b #>> t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('tstzspan <<# tpose', (SELECT COUNT(*) FROM tbl_tpose2d_span t2, tbl_tpose2d_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox <<# tpose', (SELECT COUNT(*) FROM tbl_tpose2d_box t2, tbl_tpose2d_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|=| stbox', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tpose2d_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tpose2d_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|=| tpose', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tpose2d_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tpose2d_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tpose_mest(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tpose2d_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tpose2d_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
-------------------------------------------------------------------------------
CREATE INDEX tbl_tpose2d_idx_rtree_equi ON tbl_tpose2d_idx
  USING mgist(temp tpose_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox x';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< tpose';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< stbox x';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &< t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &< t2.temp')
WHERE op = '&< tpose';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp &> t2.b')
WHERE op = '&> stbox';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp &> t2.b')
WHERE op = '&> stbox x';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &> t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp &> t2.temp')
WHERE op = '&> tpose';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp >> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_box t2 WHERE t1.temp >> t2.b')
WHERE op = '>> stbox';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp >> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_xbox t2 WHERE t1.temp >> t2.b')
WHERE op = '>> stbox x';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose2d_idx t1, tbl_tpose2d_val t2 WHERE t1.temp >> t2.temp)::text,
