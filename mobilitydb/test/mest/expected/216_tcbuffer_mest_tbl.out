INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('|&> stbox', (SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_box t2 WHERE t1.temp |&> t2.b)::text);
INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('|&> stbox x', (SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_xbox t2 WHERE t1.temp |&> t2.b)::text);
INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('|&> tcbuffer', (SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_val t2 WHERE t1.temp |&> t2.temp)::text);
INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('-|- tstzspan', (SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_span t2 WHERE t1.temp -|- t2.t)::text);
