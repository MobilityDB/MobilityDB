INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('stbox ~= tcbuffer', (SELECT COUNT(*) FROM tbl_tcbuffer_box t2, tbl_tcbuffer_idx t1 WHERE t2.b ~= t1.temp)::text);
INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('tstzspan <@ tcbuffer', (SELECT COUNT(*) FROM tbl_tcbuffer_span t2, tbl_tcbuffer_idx t1 WHERE t2.t <@ t1.temp)::text);
