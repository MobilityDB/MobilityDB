INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('|=| tcbuffer', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tcbuffer_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tcbuffer_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tcbuffer_mest(op, no_idx) VALUES ('|=| geometry', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tcbuffer_geo t2, LATERAL (SELECT t1.temp |=| t2.g AS d FROM tbl_tcbuffer_idx t1 ORDER BY t1.temp |=| t2.g LIMIT 3) s WHERE t2.knn));
-------------------------------------------------------------------------------
CREATE INDEX tbl_tcbuffer_idx_rtree_equi ON tbl_tcbuffer_idx
  USING mgist(temp tcbuffer_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tcbuffer_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_box t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_tcbuffer_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tcbuffer_idx t1, tbl_tcbuffer_xbox t2 WHERE t1.temp << t2.b')
