-------------------------------------------------------------------------------
CREATE INDEX tbl_tpose3d_idx_rtree_equi ON tbl_tpose3d_idx
  USING mgist(temp tpose_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_box t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< stbox x';
UPDATE test_tpose_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_val t2 WHERE t1.temp << t2.temp')
