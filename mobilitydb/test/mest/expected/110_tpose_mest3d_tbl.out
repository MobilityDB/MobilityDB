INSERT INTO test_tpose_mest(op, no_idx) VALUES ('stbox >> tpose', (SELECT COUNT(*) FROM tbl_tpose3d_box t2, tbl_tpose3d_idx t1 WHERE t2.b >> t1.temp)::text);
