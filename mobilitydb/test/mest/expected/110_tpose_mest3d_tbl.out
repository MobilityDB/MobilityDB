INSERT INTO test_tpose_mest(op, no_idx) VALUES ('&<# tstzspan', (SELECT COUNT(*) FROM tbl_tpose3d_idx t1, tbl_tpose3d_span t2 WHERE t1.temp &<# t2.t)::text);
