-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a
-- tfloat, keyed by the tboxes of the pieces of the value, one per split (equi,
-- seg, tile). Under each index the ever and always overlaps, with each right
-- argument they declare, answer the rows a sequential scan gives, from a plan that
-- probes the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_tfloat_idx;
NOTICE:  table "tbl_tfloat_idx" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_idx AS
WITH base(k, temp) AS (
  SELECT k, temp FROM tbl_tfloat_big
  UNION ALL
  SELECT k + 10100, temp FROM tbl_tfloat_inst
  UNION ALL
  SELECT k + 10200, temp FROM tbl_tfloat_discseq
  UNION ALL
  SELECT k + 10300, temp FROM tbl_tfloat_contseq
  UNION ALL
  SELECT k + 10400, temp FROM tbl_tfloat_seqset )
SELECT k + n * 10500 AS k, shiftTime(temp, n * interval '1 week') AS temp
FROM base, generate_series(0, 0) AS n;
ANALYZE tbl_tfloat_idx;
-- The values, boxes, value spans and periods the operators are given. Those of
-- the fixture are random, so they meet few values exactly: the others come from
-- the rows of the table, so that every operator has rows to answer.
DROP TABLE IF EXISTS tbl_tfloat_src;
NOTICE:  table "tbl_tfloat_src" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_src AS
SELECT k, temp, temp::tbox AS b, temp::tstzspan AS t, valueSpan(temp) AS v
FROM tbl_tfloat_idx WHERE k % 1000 = 0 AND temp IS NOT NULL;
-- A value of the fixture, a value of the table, and one whose period ends where
-- that of the value starts. The search for the nearest values, whose distance
-- costs more than a box, is given the second alone.
DROP TABLE IF EXISTS tbl_tfloat_val;
NOTICE:  table "tbl_tfloat_val" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_val AS
SELECT temp, false AS knn FROM tbl_tfloat WHERE k % 20 = 0
UNION ALL
SELECT temp, true FROM tbl_tfloat_src
UNION ALL
SELECT shiftTime(temp, lower(t) - upper(t)), false FROM tbl_tfloat_src;
ANALYZE tbl_tfloat_val;
-- The box of a value of the fixture, the box of a value, one around it, one
-- inside it, and one whose period meets it
DROP TABLE IF EXISTS tbl_tfloat_box;
NOTICE:  table "tbl_tfloat_box" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_box AS
SELECT temp::tbox AS b, false AS knn FROM tbl_tfloat WHERE k % 20 = 0
UNION ALL
SELECT b, true FROM tbl_tfloat_src
UNION ALL
SELECT expandTime(expandValue(b, 1::float), interval '1 day'), false FROM tbl_tfloat_src
UNION ALL
SELECT tbox(format('[%s, %s]', (lower(v) + upper(v)) / 2, (lower(v) + upper(v)) / 2)::floatspan,
    tstzspan(format('[%s, %s]', lower(t) + (upper(t) - lower(t)) / 2,
      lower(t) + (upper(t) - lower(t)) / 2))), false
FROM tbl_tfloat_src
UNION ALL
SELECT tbox(v, tstzspan(format('[%s, %s%s', lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END))), false
FROM tbl_tfloat_src;
ANALYZE tbl_tfloat_box;
-- A box of values alone, which the operators on time refuse: one around a
-- value, one inside it, the values of a value, and one that meets them
DROP TABLE IF EXISTS tbl_tfloat_xbox;
NOTICE:  table "tbl_tfloat_xbox" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_xbox AS
SELECT tbox(format('[%s, %s]', lower(v) - 1::float, upper(v) + 1::float)::floatspan) AS b
FROM tbl_tfloat_src
UNION ALL
SELECT tbox(format('[%s, %s]', (lower(v) + upper(v)) / 2, (lower(v) + upper(v)) / 2)::floatspan) AS b
FROM tbl_tfloat_src
UNION ALL
SELECT tbox(v) AS b
FROM tbl_tfloat_src
UNION ALL
SELECT tbox(format('[%s, %s]', upper(v), upper(v) + 1::float)::floatspan) AS b
FROM tbl_tfloat_src;
ANALYZE tbl_tfloat_xbox;
-- The values of a value of the fixture, the values of a value, a span around
-- them, one inside them, and one that meets them
DROP TABLE IF EXISTS tbl_tfloat_vspan;
NOTICE:  table "tbl_tfloat_vspan" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_vspan AS
SELECT valueSpan(temp) AS v, false AS knn FROM tbl_tfloat WHERE k % 20 = 0
UNION ALL
SELECT v, true FROM tbl_tfloat_src
UNION ALL
SELECT format('[%s, %s]', lower(v) - 1::float, upper(v) + 1::float)::floatspan, false
FROM tbl_tfloat_src
UNION ALL
SELECT format('[%s, %s]', (lower(v) + upper(v)) / 2, (lower(v) + upper(v)) / 2)::floatspan, false
FROM tbl_tfloat_src
UNION ALL
SELECT format('[%s, %s]', upper(v), upper(v) + 1::float)::floatspan, false
FROM tbl_tfloat_src;
ANALYZE tbl_tfloat_vspan;
-- A period of the fixture, the period of a value, one around it, one inside it,
-- and one that meets it
DROP TABLE IF EXISTS tbl_tfloat_span;
NOTICE:  table "tbl_tfloat_span" does not exist, skipping
CREATE TEMP TABLE tbl_tfloat_span AS
SELECT t FROM tbl_tstzspan WHERE k % 20 = 0
UNION ALL
SELECT t FROM tbl_tfloat_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) - interval '1 day', upper(t) + interval '1 day'))
FROM tbl_tfloat_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2))
FROM tbl_tfloat_src
UNION ALL
SELECT tstzspan(format('[%s, %s%s', lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END))
FROM tbl_tfloat_src;
ANALYZE tbl_tfloat_span;
DROP TABLE IF EXISTS test_tfloat_mest;
NOTICE:  table "test_tfloat_mest" does not exist, skipping
CREATE TEMP TABLE test_tfloat_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_tile_idx text, rtree_tile_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_tile_idx text, quadtree_tile_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_tile_idx text, kdtree_tile_probe boolean);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<< floatspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp << t2.v)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<< tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp << t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<< tbox x', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp << t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<< tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp << t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&< floatspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &< t2.v)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&< tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &< t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&< tbox x', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &< t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&< tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &< t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&> floatspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &> t2.v)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&> tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &> t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&> tbox x', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &> t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &> t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('>> floatspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp >> t2.v)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('>> tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp >> t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('>> tbox x', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp >> t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('>> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp >> t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<@ tstzspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp <@ t2.t)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<@ floatspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp <@ t2.v)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<@ tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp <@ t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<@ tbox x', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp <@ t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<@ tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp <@ t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&<# tstzspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp &<# t2.t)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&<# tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &<# t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('&<# tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &<# t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<<# tstzspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp <<# t2.t)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<<# tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp <<# t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('<<# tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp <<# t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('#>> tstzspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp #>> t2.t)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('#>> tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp #>> t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('#>> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp #>> t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('#&> tstzspan', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp #&> t2.t)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('#&> tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp #&> t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('#&> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp #&> t2.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('?&& tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp ?&& t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('%&& tbox', (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp %&& t2.b)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tbox >> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b >> t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tbox << tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b << t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tstzspan @> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t @> t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tbox @> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b @> t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tstzspan #>> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t #>> t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tbox #>> tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b #>> t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tstzspan <<# tfloat', (SELECT COUNT(*) FROM tbl_tfloat_span t2, tbl_tfloat_idx t1 WHERE t2.t <<# t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('tbox <<# tfloat', (SELECT COUNT(*) FROM tbl_tfloat_box t2, tbl_tfloat_idx t1 WHERE t2.b <<# t1.temp)::text);
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('|=| floatspan', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tfloat_vspan t2, LATERAL (SELECT t1.temp |=| t2.v AS d FROM tbl_tfloat_idx t1 ORDER BY t1.temp |=| t2.v LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('|=| tbox', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tfloat_box t2, LATERAL (SELECT t1.temp |=| t2.b AS d FROM tbl_tfloat_idx t1 ORDER BY t1.temp |=| t2.b LIMIT 3) s WHERE t2.knn));
INSERT INTO test_tfloat_mest(op, no_idx) VALUES ('|=| tfloat', (SELECT string_agg(round(s.d::numeric, least(6, 8 - floor(log(greatest(s.d, 1)::numeric))::int))::text, ',' ORDER BY s.d) FROM tbl_tfloat_val t2, LATERAL (SELECT t1.temp |=| t2.temp AS d FROM tbl_tfloat_idx t1 ORDER BY t1.temp |=| t2.temp LIMIT 3) s WHERE t2.knn));
-------------------------------------------------------------------------------
CREATE INDEX tbl_tfloat_idx_rtree_equi ON tbl_tfloat_idx
  USING mgist(temp tfloat_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp << t2.v)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp << t2.v')
WHERE op = '<< floatspan';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp << t2.b')
WHERE op = '<< tbox';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp << t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp << t2.b')
WHERE op = '<< tbox x';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp << t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp << t2.temp')
WHERE op = '<< tfloat';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &< t2.v)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &< t2.v')
WHERE op = '&< floatspan';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &< t2.b')
WHERE op = '&< tbox';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &< t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &< t2.b')
WHERE op = '&< tbox x';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &< t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &< t2.temp')
WHERE op = '&< tfloat';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &> t2.v)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp &> t2.v')
WHERE op = '&> floatspan';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp &> t2.b')
WHERE op = '&> tbox';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp &> t2.b')
WHERE op = '&> tbox x';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &> t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp &> t2.temp')
WHERE op = '&> tfloat';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp >> t2.v)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp >> t2.v')
WHERE op = '>> floatspan';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp >> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp >> t2.b')
WHERE op = '>> tbox';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp >> t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp >> t2.b')
WHERE op = '>> tbox x';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp >> t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp >> t2.temp')
WHERE op = '>> tfloat';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp <@ t2.t)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_span t2 WHERE t1.temp <@ t2.t')
WHERE op = '<@ tstzspan';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp <@ t2.v)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_vspan t2 WHERE t1.temp <@ t2.v')
WHERE op = '<@ floatspan';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp <@ t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_box t2 WHERE t1.temp <@ t2.b')
WHERE op = '<@ tbox';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp <@ t2.b)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_xbox t2 WHERE t1.temp <@ t2.b')
WHERE op = '<@ tbox x';
UPDATE test_tfloat_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tfloat_idx t1, tbl_tfloat_val t2 WHERE t1.temp <@ t2.temp)::text,
