WHERE op = '%&& tstzspan';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t ~= t1.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t ~= t1.temp')
WHERE op = 'tstzspan ~= tbool';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t @> t1.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t @> t1.temp')
