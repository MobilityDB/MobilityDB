WHERE op = '?&& tstzspan';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp %&& t2.t)::text,
