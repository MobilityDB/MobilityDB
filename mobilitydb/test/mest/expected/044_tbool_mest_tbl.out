-------------------------------------------------------------------------------
-- The multi-entry R-tree mgist, quad-tree and k-d tree mspgist indexes of a tbool,
-- keyed by the tstzspanes of the pieces of the value, one per split (equi, seg,
-- bin). Under each index the ever and always overlaps, with each right argument
-- they declare, answer the rows a sequential scan gives, from a plan that probes
-- the index.
-------------------------------------------------------------------------------
CREATE FUNCTION pg_temp.test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
DROP TABLE IF EXISTS tbl_tbool_idx;
NOTICE:  table "tbl_tbool_idx" does not exist, skipping
CREATE TEMP TABLE tbl_tbool_idx AS
WITH base(k, temp) AS (
  SELECT k, temp FROM tbl_tbool_big
  UNION ALL
  SELECT k + 10100, temp FROM tbl_tbool_inst
  UNION ALL
  SELECT k + 10200, temp FROM tbl_tbool_discseq
  UNION ALL
  SELECT k + 10300, temp FROM tbl_tbool_contseq
  UNION ALL
  SELECT k + 10400, temp FROM tbl_tbool_seqset )
SELECT k + n * 10500 AS k, shiftTime(temp, n * interval '1 week') AS temp
FROM base, generate_series(0, 0) AS n;
ANALYZE tbl_tbool_idx;
-- The values and periods the operators are given. Those of the fixture are
-- random, so they meet few values exactly: the others come from the rows of the
-- table, so that every operator has rows to answer.
DROP TABLE IF EXISTS tbl_tbool_src;
NOTICE:  table "tbl_tbool_src" does not exist, skipping
CREATE TEMP TABLE tbl_tbool_src AS
SELECT k, temp, temp::tstzspan AS t
FROM tbl_tbool_idx WHERE k % 1000 = 0 AND temp IS NOT NULL;
-- A value of the fixture, a value of the table, and one whose period ends where
-- that of the value starts
DROP TABLE IF EXISTS tbl_tbool_val;
NOTICE:  table "tbl_tbool_val" does not exist, skipping
CREATE TEMP TABLE tbl_tbool_val AS
SELECT temp, false AS knn FROM tbl_tbool WHERE k % 20 = 0
UNION ALL
SELECT temp, true FROM tbl_tbool_src
UNION ALL
SELECT shiftTime(temp, lower(t) - upper(t)), false FROM tbl_tbool_src;
ANALYZE tbl_tbool_val;
-- A period of the fixture, the period of a value, one around it, one inside it,
-- and one that meets it
DROP TABLE IF EXISTS tbl_tbool_span;
NOTICE:  table "tbl_tbool_span" does not exist, skipping
CREATE TEMP TABLE tbl_tbool_span AS
SELECT t FROM tbl_tstzspan WHERE k % 20 = 0
UNION ALL
SELECT t FROM tbl_tbool_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) - interval '1 day', upper(t) + interval '1 day'))
FROM tbl_tbool_src
UNION ALL
SELECT tstzspan(format('[%s, %s]', lower(t) + (upper(t) - lower(t)) / 2, lower(t) + (upper(t) - lower(t)) / 2))
FROM tbl_tbool_src
UNION ALL
SELECT tstzspan(format('[%s, %s%s', lower(t) - interval '1 hour', lower(t),
    CASE WHEN lowerInc(t) THEN ')' ELSE ']' END))
FROM tbl_tbool_src;
ANALYZE tbl_tbool_span;
DROP TABLE IF EXISTS test_tbool_mest;
NOTICE:  table "test_tbool_mest" does not exist, skipping
CREATE TEMP TABLE test_tbool_mest(op text, no_idx text,
  rtree_equi_idx text, rtree_equi_probe boolean,
  rtree_seg_idx text, rtree_seg_probe boolean,
  rtree_bin_idx text, rtree_bin_probe boolean,
  quadtree_equi_idx text, quadtree_equi_probe boolean,
  quadtree_seg_idx text, quadtree_seg_probe boolean,
  quadtree_bin_idx text, quadtree_bin_probe boolean,
  kdtree_equi_idx text, kdtree_equi_probe boolean,
  kdtree_seg_idx text, kdtree_seg_probe boolean,
  kdtree_bin_idx text, kdtree_bin_probe boolean);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('~= tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp ~= t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('~= tbool', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp ~= t2.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('<@ tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp <@ t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('<@ tbool', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp <@ t2.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('&<# tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp &<# t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('&<# tbool', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp &<# t2.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('<<# tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp <<# t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('<<# tbool', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp <<# t2.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('#>> tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp #>> t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('#>> tbool', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp #>> t2.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('#&> tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp #&> t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('#&> tbool', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp #&> t2.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('?&& tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp ?&& t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('%&& tstzspan', (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp %&& t2.t)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('tstzspan ~= tbool', (SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t ~= t1.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('tstzspan @> tbool', (SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t @> t1.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('tstzspan #>> tbool', (SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t #>> t1.temp)::text);
INSERT INTO test_tbool_mest(op, no_idx) VALUES ('tstzspan <<# tbool', (SELECT COUNT(*) FROM tbl_tbool_span t2, tbl_tbool_idx t1 WHERE t2.t <<# t1.temp)::text);
-------------------------------------------------------------------------------
CREATE INDEX tbl_tbool_idx_rtree_equi ON tbl_tbool_idx
  USING mgist(temp tbool_mrtree_equisplit_ops);
SET enable_seqscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_sort = off;
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp ~= t2.t)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp ~= t2.t')
WHERE op = '~= tstzspan';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp ~= t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp ~= t2.temp')
WHERE op = '~= tbool';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp <@ t2.t)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp <@ t2.t')
WHERE op = '<@ tstzspan';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp <@ t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp <@ t2.temp')
WHERE op = '<@ tbool';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp &<# t2.t)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_span t2 WHERE t1.temp &<# t2.t')
WHERE op = '&<# tstzspan';
UPDATE test_tbool_mest SET rtree_equi_idx = (SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp &<# t2.temp)::text,
  rtree_equi_probe = pg_temp.test_probes_index('SELECT COUNT(*) FROM tbl_tbool_idx t1, tbl_tbool_val t2 WHERE t1.temp &<# t2.temp')
