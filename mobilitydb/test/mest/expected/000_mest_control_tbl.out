INSERT INTO test_tgeompoint_mest(op, no_idx) VALUES ('<< tgeompoint', (SELECT COUNT(*) FROM tbl_tgeompoint_idx t1, tbl_tgeompoint t2 WHERE t1.temp << t2.temp)::text);
