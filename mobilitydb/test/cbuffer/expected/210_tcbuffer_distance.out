 7.500000
(1 row)

-- The same box with no period measures the whole temporal buffer
SELECT round(nearestApproachDistance(tcbuffer '[Cbuffer(Point(0 0), 0.5)@2001-01-01, Cbuffer(Point(4 0), 0.5)@2001-01-05]', stbox 'STBOX X((10,-1),(12,1))')::numeric, 6);
