SELECT round(ST_Length(shortestLine(tcbuffer '[Cbuffer(Point(0 0), 1)@2001-01-01, Cbuffer(Point(10 0), 5)@2001-01-05]', cbuffer 'Cbuffer(Point(5 6), 0)'))::numeric, 6);
