WITH test(doc) AS (
  SELECT asGeoPose(tposechain 'SRID=4326;PoseChain(GeodPose(Point Z(-122.3 47.7 11), 1, 0, 0, 0),
    Pose(Point Z(2 0 0), 1, 0, 0, 0))@2021-04-28 05:36:10.083+00', 9) )
SELECT asEWKT(round(tposechainFromGeoPose(doc), 6)) FROM test;
                                                             asewkt                                                             
--------------------------------------------------------------------------------------------------------------------------------
