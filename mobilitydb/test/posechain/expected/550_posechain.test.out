SELECT asEWKT(round(pose(posechain(ARRAY[pose(ST_Point(0,0), 0),
  pose(ST_Point(1,0), pi()/2), pose(ST_Point(1,0), 0)]), n), 6))
  FROM generate_series(1, 3) AS n;
