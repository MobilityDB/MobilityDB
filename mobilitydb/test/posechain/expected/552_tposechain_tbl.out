\copy tbl_tposechain_tmp FROM 'tbl_tposechain2d' (FORMAT BINARY);
SELECT COUNT(*) FROM tbl_tposechain2d t1, tbl_tposechain_tmp t2 WHERE t1.k = t2.k AND t1.temp <> t2.temp;
