         tposechain '[PoseChain(Pose(Point(5 5), 0.2))@2001-01-01, PoseChain(Pose(Point(7 7), 0.2))@2001-01-03]' AS seq2,
         geometry 'Polygon((0 0,0 4,4 4,4 0,0 0))' AS region,
