CREATE FUNCTION test_probes_index(query text)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE
  line text;
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || query LOOP
    IF line LIKE '%Index Cond%' OR line LIKE '%Order By%' THEN
      RETURN true;
    END IF;
  END LOOP;
  RETURN false;
END;
$$;
CREATE FUNCTION
DROP TABLE IF EXISTS tbl_npointset_idx;
NOTICE:  table "tbl_npointset_idx" does not exist, skipping
DROP TABLE
CREATE TABLE tbl_npointset_idx AS
WITH src AS (
SELECT k, n AS s FROM tbl_npointset)
SELECT k, s FROM src
UNION ALL
SELECT t1.k + 100000, t1.s + t2.s FROM src t1, src t2 WHERE t2.k = t1.k + 1;
SELECT 199
ANALYZE tbl_npointset_idx;
ANALYZE
DROP TABLE IF EXISTS test_npointset_idx;
NOTICE:  table "test_npointset_idx" does not exist, skipping
DROP TABLE
CREATE TABLE test_npointset_idx(op text, no_idx text, rtree_idx text, quadtree_idx text,
  kdtree_idx text, rtree_probe boolean, quadtree_probe boolean,
  kdtree_probe boolean);
CREATE TABLE
INSERT INTO test_npointset_idx(op, no_idx) VALUES ('&&', (SELECT COUNT(*) FROM tbl_npointset_idx t1, tbl_npointset_idx t2 WHERE t1.s && t2.s)::text);
INSERT 0 1
INSERT INTO test_npointset_idx(op, no_idx) VALUES ('=', (SELECT COUNT(*) FROM tbl_npointset_idx t1, tbl_npointset_idx t2 WHERE t1.s = t2.s)::text);
INSERT 0 1
INSERT INTO test_npointset_idx(op, no_idx) VALUES ('@> set', (SELECT COUNT(*) FROM tbl_npointset_idx t1, tbl_npointset_idx t2 WHERE t1.s @> t2.s)::text);
INSERT 0 1
INSERT INTO test_npointset_idx(op, no_idx) VALUES ('<@', (SELECT COUNT(*) FROM tbl_npointset_idx t1, tbl_npointset_idx t2 WHERE t1.s <@ t2.s)::text);
INSERT 0 1
INSERT INTO test_npointset_idx(op, no_idx) VALUES ('@> value', (SELECT COUNT(*) FROM tbl_npointset_idx t1, (SELECT startValue(s) AS v FROM tbl_npointset_idx) t2 WHERE t1.s @> t2.v)::text);
INSERT 0 1
INSERT INTO test_npointset_idx(op, no_idx) VALUES ('<->', (SELECT COUNT(DISTINCT d)::text || ':' || md5(array_agg(d ORDER BY rn)::text) FROM (SELECT d, row_number() OVER () AS rn FROM (SELECT round((s <-> (SELECT startValue(s) FROM tbl_npointset_idx WHERE s IS NOT NULL ORDER BY k LIMIT 1))::numeric, 6) AS d FROM tbl_npointset_idx WHERE s IS NOT NULL ORDER BY s <-> (SELECT startValue(s) FROM tbl_npointset_idx WHERE s IS NOT NULL ORDER BY k LIMIT 1)) t1) t2)::text);
INSERT 0 1
