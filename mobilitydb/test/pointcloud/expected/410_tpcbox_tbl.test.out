CREATE TABLE tbl_tpcbox_pcid AS
  SELECT 1 AS k, tpcboxZT(20, 0, 0, 30, 10, 10,
    tstzspan '[2001-01-01, 2001-12-31]', 2, 0) AS b;
SELECT 1
