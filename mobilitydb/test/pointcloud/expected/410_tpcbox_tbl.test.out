WITH test AS (
  SELECT b |=| tpcboxZT(200, 200, 200, 210, 210, 210,
  tstzspan '[2001-06-01, 2001-12-31]', 1, 0) AS distance
  FROM tbl_tpcbox ORDER BY 1 LIMIT 3 )
