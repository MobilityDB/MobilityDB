						<row><entry>Minimum / maximum</entry><entry>tMinTransition</entry><entry>tMinCombine</entry><entry>tMinFinal</entry></row>
						<row><entry></entry><entry>tMaxTransition</entry><entry>tMaxCombine</entry><entry>tMaxFinal</entry></row>
						<row><entry></entry><entry>wMinTransition</entry><entry>wMinCombine</entry><entry>wMinFinal</entry></row>
